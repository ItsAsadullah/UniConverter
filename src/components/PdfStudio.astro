                <option value="13" selected>মাঝারি (13 pt)</option>
                <option value="16">বড় (16 pt)</option>
                <option value="20">শিরোনাম (20 pt)</option>
              </select>
            </div>
            <div class="pdf-field-group">
              <label for="doc2pdfTitle">ডকুমেন্ট শিরোনাম (ঐচ্ছিক):</label>
              <input type="text" id="doc2pdfTitle" name="doc2pdfTitle" placeholder="যেমন: দাপ্তরিক চিঠি / প্রতিবেদন">
            </div>
          </div>

          <div class="pdf-field-group" style="margin-top:.75rem;">
            <label for="doc2pdfText">ডকুমেন্টের বিস্তারিত লেখা:</label>
            <textarea id="doc2pdfText" class="textbox pdf-doc-textarea" rows="8" placeholder="এখানে আপনার লেখা পেস্ট করুন বা লিখুন…"></textarea>
          </div>

          <div class="pdf-action-bar" style="margin-top:.85rem;">
            <div class="pdf-summary-pill" id="doc2pdfSummary">A4 প্রিন্ট রেডি PDF</div>
            <button type="button" class="btn btn--primary pdf-main-action" id="doc2pdfRunBtn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
              লেখা থেকে PDF তৈরি করুন
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Merge: per-file multi-page viewer (rotate / delete / drag-reorder each page) -->
  <dialog class="pdf-dialog" id="pdfPagesDialog" closedby="any" aria-labelledby="pdfPagesDialogTitle">
    <div class="pdf-dialog__head">
      <div>
        <h3 class="pdf-dialog__title" id="pdfPagesDialogTitle">সব পৃষ্ঠা</h3>
        <p class="pdf-dialog__sub" id="pdfPagesDialogSub"></p>
      </div>
      <div class="pdf-ws-actions">
        <button type="button" class="chip-btn" id="pdfPagesDlgRotL">↺ সব</button>
        <button type="button" class="chip-btn" id="pdfPagesDlgRotR">↻ সব</button>
        <button type="button" class="ai-close pdf-dialog__close" id="pdfPagesDlgClose" aria-label="বন্ধ করুন">✕</button>
      </div>
    </div>
    <div class="pdf-dialog__body">
      <div class="pdf-pages-grid pdf-pages-grid--dialog" id="pdfPagesDialogGrid"></div>
    </div>
    <div class="pdf-dialog__foot">
      <button type="button" class="btn btn--primary" id="pdfPagesDlgDone">সম্পন্ন</button>
    </div>
  </dialog>

  <!-- Large page preview / before-after quality comparison -->
  <dialog class="pdf-dialog pdf-dialog--wide" id="pdfPreviewDialog" closedby="any" aria-labelledby="pdfPreviewTitle">
    <div class="pdf-dialog__head">
      <div>
        <h3 class="pdf-dialog__title" id="pdfPreviewTitle">প্রিভিউ</h3>
        <p class="pdf-dialog__sub" id="pdfPreviewSub"></p>
      </div>
      <div class="pdf-ws-actions">
        <button type="button" class="chip-btn" id="pdfPreviewPrev" aria-label="আগের পৃষ্ঠা">← আগের</button>
        <span class="pdf-summary-pill" id="pdfPreviewCounter">১ / ১</span>
        <button type="button" class="chip-btn" id="pdfPreviewNext" aria-label="পরের পৃষ্ঠা">পরের →</button>
        <button type="button" class="ai-close pdf-dialog__close" id="pdfPreviewClose" aria-label="বন্ধ করুন">✕</button>
      </div>
    </div>
    <div class="pdf-dialog__body">
      <div class="pdf-preview-stage" id="pdfPreviewStage"></div>
    </div>
  </dialog>
</div>
