---
import '../styles/nid-editor.css';
interface Props {
  initialTab?: 'hub' | 'resize' | 'compress' | 'crop' | 'convert' | 'combine' | 'colors';
}

const { initialTab = 'hub' } = Astro.props;
---
<div class="tool-view" id="tool-image" data-initial-tab={initialTab}>
  <section class="card util-card pdf-studio-card img-studio-card" aria-label="ইমেজ স্টুডিও">
    <!-- Top Sub-Tool Navigation -->
    <div class="pdf-nav-bar" role="tablist" aria-label="ইমেজ টুলস মেনু">
      <button type="button" class:list={['pdf-nav-btn', { active: initialTab === 'hub' }]} data-img-tab="hub" role="tab" aria-selected={initialTab === 'hub' ? 'true' : 'false'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        <span>সব ইমেজ টুলস</span>
      </button>
      <button type="button" class:list={['pdf-nav-btn', { active: initialTab === 'resize' }]} data-img-tab="resize" role="tab" aria-selected={initialTab === 'resize' ? 'true' : 'false'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
        <span>রিসাইজ ও প্রিসেট</span>
      </button>
      <button type="button" class:list={['pdf-nav-btn', { active: initialTab === 'compress' }]} data-img-tab="compress" role="tab" aria-selected={initialTab === 'compress' ? 'true' : 'false'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/></svg>
        <span>কমপ্রেস ইমেজ</span>
      </button>
      <button type="button" class:list={['pdf-nav-btn', { active: initialTab === 'crop' }]} data-img-tab="crop" role="tab" aria-selected={initialTab === 'crop' ? 'true' : 'false'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2v14a2 2 0 0 0 2 2h14"/><path d="M18 22V8a2 2 0 0 0-2-2H2"/></svg>
        <span>ক্রপ ও রাউন্ড</span>
      </button>
      <button type="button" class:list={['pdf-nav-btn', { active: initialTab === 'convert' }]} data-img-tab="convert" role="tab" aria-selected={initialTab === 'convert' ? 'true' : 'false'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
        <span>কনভার্ট ও ইফেক্ট</span>
      </button>
      <button type="button" class:list={['pdf-nav-btn', { active: initialTab === 'combine' }]} data-img-tab="combine" role="tab" aria-selected={initialTab === 'combine' ? 'true' : 'false'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="8" height="16" rx="1.5"/><rect x="13" y="4" width="8" height="16" rx="1.5"/></svg>
        <span>ছবি জোড়া / NID</span>
      </button>
      <button type="button" class:list={['pdf-nav-btn', { active: initialTab === 'colors' }]} data-img-tab="colors" role="tab" aria-selected={initialTab === 'colors' ? 'true' : 'false'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2a10 10 0 1 0 0 20 2 2 0 0 0 2-2v-.5a1.5 1.5 0 0 1 1.5-1.5H17a5 5 0 0 0 5-5c0-5.5-4.5-11-10-11z"/></svg>
        <span>কালার পিকার</span>
      </button>
    </div>

    <div class="util-body pdf-studio-body">
      <!-- ========================================== 0. HUB OVERVIEW -->
      <div class="img-pane" id="img-pane-hub" hidden={initialTab !== 'hub'}>
        <div class="pdf-hub-hero">
          <h2 class="pdf-hub-title">অল-ইন-ওয়ান <span>ইমেজ স্টুডিও</span></h2>
        </div>

        <div class="pdf-hub-grid">
          <button type="button" class="pdf-hub-card" data-open-img="resize" data-preset="job-photo" data-accent="teal">
            <span class="pdf-hub-card__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </span>
            <span class="pdf-hub-card__title">রিসাইজ ও সরকারি ফর্ম প্রিসেট</span>
            <span class="pdf-hub-card__desc">চাকরির ছবি (300×300), আনসার ভিডিপি (250×250), স্বাক্ষর (300×80 ও 300×100), পাসপোর্ট সাইজ ও পজিশনিং।</span>
          </button>

          <button type="button" class="pdf-hub-card" data-open-img="compress" data-accent="green">
            <span class="pdf-hub-card__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/></svg>
            </span>
            <span class="pdf-hub-card__title">কমপ্রেস ইমেজ</span>
            <span class="pdf-hub-card__desc">কোয়ালিটি ঠিক রেখে ছবির KB কমান এবং প্রিভিউ দেখে ডাউনলোড করুন।</span>
          </button>

          <button type="button" class="pdf-hub-card" data-open-img="crop" data-accent="purple">
            <span class="pdf-hub-card__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2v14a2 2 0 0 0 2 2h14"/><path d="M18 22V8a2 2 0 0 0-2-2H2"/></svg>
            </span>
            <span class="pdf-hub-card__title">ক্রপ, কাস্টম সাইজ ও রাউন্ড ফটো</span>
            <span class="pdf-hub-card__desc">কাস্টম সাইজে (px) বা অনুপাতে ছবি ক্রপ (250×250, 300×100, 1:1), ঘোরান ও বৃত্তাকার ছবি তৈরি করুন।</span>
          </button>

          <button type="button" class="pdf-hub-card" data-open-img="convert" data-accent="amber">
            <span class="pdf-hub-card__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            </span>
            <span class="pdf-hub-card__title">কনভার্ট, ইফেক্ট ও ওয়াটারমার্ক</span>
            <span class="pdf-hub-card__desc">JPG ⇄ PNG ⇄ WebP ⇄ Base64 রূপান্তর, ছবির ওপর লেখা, বর্ডার ও ফটো ইফেক্ট।</span>
          </button>

          <button type="button" class="pdf-hub-card" data-open-img="combine" data-accent="blue">
            <span class="pdf-hub-card__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="8" height="16" rx="1.5"/><rect x="13" y="4" width="8" height="16" rx="1.5"/></svg>
            </span>
            <span class="pdf-hub-card__title">আইডি কার্ড স্ক্যানার ও ছবি জোড়া</span>
            <span class="pdf-hub-card__desc">অটো এজ ডিটেকশন, ৪-কোণা পার্সপেক্টিভ ক্রপ ও কালার এডজাস্ট করে A4 পাতায় উপরে-নিচে বসান।</span>
          </button>

          <button type="button" class="pdf-hub-card" data-open-img="colors" data-accent="red">
            <span class="pdf-hub-card__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2a10 10 0 1 0 0 20 2 2 0 0 0 2-2v-.5a1.5 1.5 0 0 1 1.5-1.5H17a5 5 0 0 0 5-5c0-5.5-4.5-11-10-11z"/></svg>
            </span>
            <span class="pdf-hub-card__title">কালার পিকার ও প্যালেট</span>
            <span class="pdf-hub-card__desc">যেকোনো ছবি থেকে প্রধান রঙগুলোর প্যালেট বের করুন এবং ক্লিক করে HEX/RGB কোড কপি করুন।</span>
          </button>
        </div>
      </div>

      <!-- ========================================== 1. RESIZE & GOVT FORM PRESETS -->
      <div class="img-pane" id="img-pane-resize" hidden={initialTab !== 'resize'}>
        <div class="pdf-ws-head">
          <div>
            <h3 class="pdf-ws-title">রিসাইজ ও সরকারি ফর্ম প্রিসেট</h3>
          </div>
          <div class="pdf-ws-actions" id="imgResizeTopActions" hidden>
            <button type="button" class="chip-btn chip-btn--danger" id="imgResizeResetBtn">অন্য ছবি নিন</button>
          </div>
        </div>

        <label class="pdf-dropzone" id="imgResizeDropzone" for="imgResizeInput">
          <input type="file" id="imgResizeInput" name="imgResizeInput" accept="image/*" class="visually-hidden">
          <div class="pdf-dropzone__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          </div>
          <div class="pdf-dropzone__title">রিসাইজ করার জন্য ছবি এখানে ছাড়ুন অথবা <span class="link-ish">ব্রাউজ করুন</span></div>
          <div class="pdf-dropzone__sub">JPG • PNG • WebP • GIF • BMP — সরকারি ফর্ম ও পাসপোর্ট প্রিসেটসহ</div>
        </label>

        <div class="pdf-workspace-stage" id="imgResizeStage" hidden>
          <div class="pdf-options-box">
            <fieldset class="pdf-fieldset">
              <legend class="pdf-legend">এক ক্লিকে কুইক প্রিসেট নির্বাচন করুন (Quick Presets)</legend>
              <div class="img-preset-pills" id="imgResizePresets">
                <button type="button" class="img-preset-pill active" data-w="300" data-h="300" data-kb="100" data-fit="cover" data-fmt="image/jpeg">
                  <strong>চাকরির ছবি (300×300)</strong>
                  <small>সর্বোচ্চ 100 KB • JPG</small>
                </button>
                <button type="button" class="img-preset-pill" data-w="300" data-h="80" data-kb="60" data-fit="contain" data-fmt="image/jpeg">
                  <strong>স্বাক্ষর (300×80)</strong>
                  <small>সর্বোচ্চ 60 KB • JPG</small>
                </button>
                <button type="button" class="img-preset-pill" data-w="250" data-h="250" data-kb="100" data-fit="cover" data-fmt="image/jpeg">
                  <strong>আনসার ভিডিপি ছবি (250×250)</strong>
                  <small>সর্বোচ্চ 100 KB • JPG</small>
                </button>
                <button type="button" class="img-preset-pill" data-w="300" data-h="100" data-kb="60" data-fit="contain" data-fmt="image/jpeg">
                  <strong>আনসার সাইন (300×100)</strong>
                  <small>সর্বোচ্চ 60 KB • JPG</small>
                </button>
                <button type="button" class="img-preset-pill" data-w="450" data-h="570" data-kb="0" data-fit="cover" data-fmt="image/jpeg">
                  <strong>পাসপোর্ট সাইজ (450×570)</strong>
                  <small>38×48 mm @ 300 DPI</small>
                </button>
                <button type="button" class="img-preset-pill" data-w="240" data-h="300" data-kb="0" data-fit="cover" data-fmt="image/jpeg">
                  <strong>স্ট্যাম্প সাইজ (240×300)</strong>
                  <small>20×25 mm @ 300 DPI</small>
                </button>
                <button type="button" class="img-preset-pill" data-w="1080" data-h="1080" data-kb="0" data-fit="cover" data-fmt="image/jpeg">
                  <strong>সোশ্যাল স্কয়ার (1080×1080)</strong>
                  <small>Instagram / FB Post</small>
                </button>
                <button type="button" class="img-preset-pill" data-w="1280" data-h="720" data-kb="0" data-fit="cover" data-fmt="image/jpeg">
                  <strong>HD থাম্বনেইল (1280×720)</strong>
                  <small>16:9 YouTube / Web</small>
                </button>
              </div>
            </fieldset>

            <div class="pdf-img-settings img-grid-4" style="margin-top: .9rem;">
              <div class="pdf-field-group">
                <label for="imgResizeW">প্রস্থ — Width (px):</label>
                <input type="number" id="imgResizeW" name="imgResizeW" value="300" min="1" max="8000">
              </div>
              <div class="pdf-field-group">
                <label for="imgResizeH">উচ্চতা — Height (px):</label>
                <input type="number" id="imgResizeH" name="imgResizeH" value="300" min="1" max="8000">
              </div>
              <div class="pdf-field-group">
                <label for="imgResizeMaxKb">সর্বোচ্চ সাইজ (KB লিমিট, 0 = আনলিমিটেড):</label>
                <input type="number" id="imgResizeMaxKb" name="imgResizeMaxKb" value="100" min="0" max="10000" step="5">
              </div>
              <div class="pdf-field-group">
                <label for="imgResizeBg">ব্যাকগ্রাউন্ড রঙ (Contain/JPG):</label>
                <div class="img-color-row">
                  <input type="color" id="imgResizeBg" name="imgResizeBg" value="#ffffff">
                  <button type="button" class="chip-btn" id="imgResizeBgWhite" title="সাদা ব্যাকগ্রাউন্ড">সাদা</button>
                  <button type="button" class="chip-btn" id="imgResizeBgBlue" title="পাসপোর্ট নীল ব্যাকগ্রাউন্ড">নীল</button>
                </div>
              </div>
            </div>

            <div class="img-controls-row" style="margin-top: .85rem;">
              <label class="switch pdf-inline-switch">
                <input type="checkbox" id="imgResizeLockRatio" name="imgResizeLockRatio">
                <span class="switch__track"><span class="switch__knob"></span></span>
                <span class="switch__label">অরিজিনাল অনুপাত লক রাখুন (Lock Aspect Ratio)</span>
              </label>

              <fieldset class="pdf-fieldset">
                <legend class="pdf-legend">ফিট মোড (Fit Mode):</legend>
                <div class="pdf-radio-inline">
                  <label class="dc-radio"><input type="radio" name="imgResizeFit" value="cover" checked> কভার / সেন্টার ক্রপ</label>
                  <label class="dc-radio"><input type="radio" name="imgResizeFit" value="contain"> পুরো ছবি রাখুন (Contain)</label>
                  <label class="dc-radio"><input type="radio" name="imgResizeFit" value="stretch"> টেনে মাপ মেলান (Stretch)</label>
                </div>
              </fieldset>

              <fieldset class="pdf-fieldset">
                <legend class="pdf-legend">আউটপুট ফরম্যাট:</legend>
                <div class="pdf-radio-inline">
                  <label class="dc-radio"><input type="radio" name="imgResizeFmt" value="image/jpeg" checked> JPG</label>
                  <label class="dc-radio"><input type="radio" name="imgResizeFmt" value="image/png"> PNG</label>
                  <label class="dc-radio"><input type="radio" name="imgResizeFmt" value="image/webp"> WebP</label>
                </div>
              </fieldset>
            </div>

            <div class="img-controls-row img-pos-toolbar" id="imgResizePosToolbar" style="margin-top: .85rem; padding-top: .75rem; border-top: 1px dashed var(--line);">
              <div class="pdf-field-group" style="min-width: 220px; flex: 1;">
                <label for="imgResizeZoom">ছবির জুম ও পজিশন (Zoom &amp; Pan): <strong id="imgResizeZoomVal">১০০%</strong></label>
                <input type="range" id="imgResizeZoom" name="imgResizeZoom" min="50" max="300" value="100">
              </div>
              <div class="img-color-row">
                <span class="pdf-hint-line" style="margin:0;">✋ প্রিভিউ ছবির ওপর মাউস বা আঙুল দিয়ে টেনে পজিশন ঠিক করুন</span>
                <button type="button" class="chip-btn" id="imgResizePosReset">🎯 মাঝখানে বসান</button>
              </div>
            </div>
          </div>

          <div class="img-dual-preview">
            <div class="img-preview-box">
              <div class="img-preview-box__head">
                <strong>অরিজিনাল ছবি</strong>
                <span id="imgResizeOrigMeta">—</span>
              </div>
              <div class="img-preview-box__canvas">
                <img id="imgResizeOrigPreview" alt="অরিজিনাল ছবির প্রিভিউ" width="300" height="300">
              </div>
            </div>
            <div class="img-preview-box img-preview-box--out">
              <div class="img-preview-box__head">
                <strong>রিসাইজড আউটপুট প্রিভিউ (টেনে পজিশন সরান)</strong>
                <span id="imgResizeOutMeta">—</span>
              </div>
              <div
                class="img-preview-box__canvas img-pan-stage"
                id="imgResizePanWrap"
                tabindex="0"
                aria-label="রিসাইজড ছবির পজিশন — মাউস বা টাচ দিয়ে টেনে অথবা অ্যারো কী চেপে ছবির অবস্থান পরিবর্তন করুন"
              >
                <img id="imgResizeOutPreview" alt="রিসাইজড ছবির প্রিভিউ" width="300" height="300" draggable="false">
                <span class="img-pan-badge" id="imgResizePanHint">✥ ড্রাগ করে পজিশন মেলান</span>
              </div>
            </div>
          </div>

          <div class="pdf-action-bar">
            <div class="pdf-summary-pill" id="imgResizeSummary">প্রস্তুত</div>
            <button type="button" class="btn btn--primary pdf-main-action" id="imgResizeDownloadBtn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
              রিসাইজড ছবি ডাউনলোড করুন
            </button>
          </div>
        </div>
      </div>

      <!-- ========================================== 2. COMPRESS IMAGE WORKSPACE -->
      <div class="img-pane" id="img-pane-compress" hidden={initialTab !== 'compress'}>
        <div class="pdf-ws-head">
          <div>
            <h3 class="pdf-ws-title">কমপ্রেস ইমেজ</h3>
          </div>
          <div class="pdf-ws-actions" id="imgCompressTopActions" hidden>
            <label class="chip-btn" for="imgCompressAddMore">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              আরও ছবি যোগ করুন
              <input type="file" id="imgCompressAddMore" name="imgCompressAddMore" accept="image/*" multiple class="visually-hidden">
            </label>
            <button type="button" class="chip-btn chip-btn--danger" id="imgCompressClearBtn">সব মুছুন</button>
          </div>
        </div>

        <label class="pdf-dropzone" id="imgCompressDropzone" for="imgCompressInput">
          <input type="file" id="imgCompressInput" name="imgCompressInput" accept="image/*" multiple class="visually-hidden">
          <div class="pdf-dropzone__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/></svg>
          </div>
          <div class="pdf-dropzone__title">কমপ্রেস করার জন্য এক বা একাধিক ছবি ছাড়ুন বা <span class="link-ish">সিলেক্ট করুন</span></div>
          <div class="pdf-dropzone__sub">JPG • PNG • WebP — কোয়ালিটি স্লাইডার ও সর্বোচ্চ KB লিমিটসহ</div>
        </label>

        <div class="pdf-workspace-stage" id="imgCompressStage" hidden>
          <div class="pdf-options-box">
            <div class="pdf-img-settings img-grid-4">
              <div class="pdf-field-group">
