          </label>
        </div>

        <div class="pdf-workspace-stage" id="imgCombineStage" hidden>
          <!-- TOP CARD SIDE SWITCHER BAR -->
          <div class="nid-studio-topbar">
            <div class="nid-card-tabs" id="nidCardTabs" role="tablist" aria-label="আইডি কার্ডের পৃষ্ঠা নির্বাচন"></div>
            <div class="nid-card-slot-Adders">
              <label class="chip-btn" for="nidReplaceFrontInput">
                সামনের ছবি বদলান
                <input type="file" id="nidReplaceFrontInput" name="nidReplaceFrontInput" accept="image/*" class="visually-hidden">
              </label>
              <label class="chip-btn" for="nidReplaceBackInput">
                পেছনের ছবি যোগ/বদলান
                <input type="file" id="nidReplaceBackInput" name="nidReplaceBackInput" accept="image/*" class="visually-hidden">
              </label>
            </div>
          </div>

          <!-- MAIN 2-COLUMN SPLIT STUDIO WORKBENCH -->
          <div class="nid-studio-grid">
            <!-- LEFT COLUMN: INTERACTIVE PERSPECTIVE CROP + FINE STRAIGHTEN + COLOR ENHANCER -->
            <div class="nid-studio-col nid-studio-col--left">
              <div class="pdf-options-box nid-scanner-box" id="nidScannerCropPanel">
                <div class="nid-scanner-box__head">
                  <strong class="nid-step-title">১. পার্সপেক্টিভ ক্রপ ও সোজা করা</strong>
                  <div class="nid-crop-toolbar">
                    <button type="button" class="chip-btn chip-btn--accent" id="nidAutoCropBtn">✨ অটো এজ ডিটেক্ট</button>
                    <button type="button" class="chip-btn" id="nidSnapRatioBtn" title="আসল আইডি কার্ডের অনুপাতে (85.6×54mm) চার কোণা সেট করুন">📐 কার্ড অনুপাত</button>
                    <button type="button" class="chip-btn" id="nidFullCropBtn">🔲 পুরো ফ্রেম</button>
                    <button type="button" class="chip-btn" id="nidRotLBtn" title="৯০ ডিগ্রি বামে ঘোরান">↺ বামে</button>
                    <button type="button" class="chip-btn" id="nidRotRBtn" title="৯০ ডিগ্রি ডানে ঘোরান">↻ ডানে</button>
                    <button type="button" class="chip-btn" id="nidFlipHBtn" title="পাশাপাশি উল্টান (Mirror Flip)">⇄ ফ্লিপ</button>
                  </div>
                </div>

                <div class="nid-crop-canvas-shell">
                  <div
                    class="img-crop-stage-wrap nid-perspective-stage"
                    id="nidCropInteractiveWrap"
                    tabindex="0"
                    aria-label="আইডি কার্ড পার্সপেক্টিভ ক্রপ — চার কোণার বিন্দু টেনে বাঁকা কার্ড সোজা করে ক্রপ করুন"
                  >
                    <canvas id="nidCropSourceCanvas"></canvas>
                    <div class="nid-scan-beam" id="nidScanBeam" hidden aria-hidden="true"></div>
                    <svg class="nid-quad-svg" id="nidQuadSvg" viewBox="0 0 100 100" aria-hidden="true">
                      <defs>
                        <mask id="nidQuadMask">
                          <rect id="nidQuadMaskBg" x="0" y="0" width="100" height="100" fill="white" />
                          <polygon id="nidQuadHole" points="10,10 90,10 90,90 10,90" fill="black" />
                        </mask>
                      </defs>
                      <rect id="nidQuadDimRect" x="0" y="0" width="100" height="100" fill="rgba(8, 18, 16, 0.62)" mask="url(#nidQuadMask)" />
                      <line id="nidGridH1" class="nid-quad-grid" x1="10" y1="36" x2="90" y2="36" />
                      <line id="nidGridH2" class="nid-quad-grid" x1="10" y1="63" x2="90" y2="63" />
                      <line id="nidGridV1" class="nid-quad-grid" x1="36" y1="10" x2="36" y2="90" />
                      <line id="nidGridV2" class="nid-quad-grid" x1="63" y1="10" x2="63" y2="90" />
                      <polygon id="nidQuadPoly" class="nid-quad-poly" points="10,10 90,10 90,90 10,90" />
                    </svg>
                    <div class="nid-quad-handles" id="nidQuadHandles">
                      <button type="button" class="nid-quad-handle nid-quad-handle--corner" data-pt="0" aria-label="উপরের বাম কোণা"></button>
                      <button type="button" class="nid-quad-handle nid-quad-handle--corner" data-pt="1" aria-label="উপরের ডান কোণা"></button>
                      <button type="button" class="nid-quad-handle nid-quad-handle--corner" data-pt="2" aria-label="নিচের ডান কোণা"></button>
                      <button type="button" class="nid-quad-handle nid-quad-handle--corner" data-pt="3" aria-label="নিচের বাম কোণা"></button>
                      <button type="button" class="nid-quad-handle nid-quad-handle--edge" data-edge="0" aria-label="উপরের ধার"></button>
                      <button type="button" class="nid-quad-handle nid-quad-handle--edge" data-edge="1" aria-label="ডান ধার"></button>
                      <button type="button" class="nid-quad-handle nid-quad-handle--edge" data-edge="2" aria-label="নিচের ধার"></button>
                      <button type="button" class="nid-quad-handle nid-quad-handle--edge" data-edge="3" aria-label="বাম ধার"></button>
                    </div>
                    <canvas class="nid-crop-loupe" id="nidCropLoupe" width="116" height="116" hidden aria-hidden="true"></canvas>
                  </div>
                </div>

                <!-- Fine Straighten / Deskew Slider + Active Cropped Card Preview Bar -->
                <div class="nid-deskew-bar">
                  <div class="pdf-field-group" style="flex:1; min-width:180px;">
                    <label for="nidFineAngle">সূক্ষ্ম রোটেশন / সোজা করুন (Straighten): <strong id="nidFineAngleVal">০°</strong></label>
                    <input type="range" id="nidFineAngle" name="nidFineAngle" min="-15" max="15" step="0.5" value="0">
                  </div>
                  <button type="button" class="chip-btn" id="nidFineAngleReset">০° সোজা</button>
                </div>

                <!-- Active Single Card Cropped Preview + Dual Card Strip -->
                <div class="nid-active-card-strip">
                  <div class="img-preview-box img-preview-box--out nid-single-preview-box">
                    <div class="img-preview-box__head">
                      <strong id="nidActiveCardTitle">সোজা ও ক্রপকৃত প্রিভিউ</strong>
                      <span id="nidActiveCardMeta">প্রস্তুত ✓</span>
                    </div>
                    <div class="img-preview-box__canvas nid-single-preview-canvas">
                      <img id="nidActiveCardPreview" alt="সোজা ও ক্রপ করা আইডি কার্ডের প্রিভিউ" width="320" height="200">
                    </div>
                  </div>
                  <div class="nid-mini-thumbs" id="nidDualPreviewStrip" aria-label="উভয় পাশের কার্ড থাম্বনেইল"></div>
                </div>
              </div>

              <!-- STEP 2: COLOR ADJUSTMENT & ENHANCEMENT -->
              <div class="pdf-options-box">
                <div class="img-controls-row" style="justify-content:space-between;">
                  <fieldset class="pdf-fieldset">
                    <legend class="pdf-legend">২. কালার ও ডকুমেন্ট ফিল্টার:</legend>
                    <div class="pdf-radio-inline">
                      <label class="dc-radio"><input type="radio" name="imgCombineScanMode" value="original" checked> অরিজিনাল</label>
                      <label class="dc-radio"><input type="radio" name="imgCombineScanMode" value="magic"> অটো এনহ্যান্স</label>
                      <label class="dc-radio"><input type="radio" name="imgCombineScanMode" value="clean"> পরিষ্কার সাদা (Clean)</label>
                      <label class="dc-radio"><input type="radio" name="imgCombineScanMode" value="bw"> ফটোকপি (B&amp;W)</label>
                      <label class="dc-radio"><input type="radio" name="imgCombineScanMode" value="grayscale"> গ্রেস্কেল</label>
                    </div>
                  </fieldset>
                  <button type="button" class="chip-btn" id="imgCombineColorResetBtn">↺ রিসেট</button>
                </div>

                <div class="pdf-img-settings img-grid-2" style="margin-top: .75rem;">
                  <div class="pdf-field-group">
                    <label for="imgCombineBright">উজ্জ্বলতা (Brightness): <strong id="imgCombineBrightVal">১০০%</strong></label>
                    <input type="range" id="imgCombineBright" name="imgCombineBright" min="50" max="180" value="100">
                  </div>
                  <div class="pdf-field-group">
                    <label for="imgCombineContrast">কনট্রাস্ট (Contrast): <strong id="imgCombineContrastVal">১০০%</strong></label>
                    <input type="range" id="imgCombineContrast" name="imgCombineContrast" min="50" max="220" value="100">
                  </div>
                  <div class="pdf-field-group">
                    <label for="imgCombineSat">রঙের গভীরতা (Saturation): <strong id="imgCombineSatVal">১০০%</strong></label>
                    <input type="range" id="imgCombineSat" name="imgCombineSat" min="0" max="200" value="100">
                  </div>
                  <div class="pdf-field-group">
                    <label for="imgCombineSharp">লেখার স্পষ্টতা (Sharpness): <strong id="imgCombineSharpVal">২০%</strong></label>
                    <input type="range" id="imgCombineSharp" name="imgCombineSharp" min="0" max="100" value="20">
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGHT COLUMN: LIVE A4 PRINT SHEET PREVIEW + LAYOUT & PRINT CONTROLS -->
            <div class="nid-studio-col nid-studio-col--right">
              <div class="pdf-options-box nid-sheet-panel">
                <div class="img-preview-box__head nid-sheet-panel__head">
                  <strong>৩. ফাইনাল প্রিন্ট শিট প্রিভিউ (Live 300 DPI)</strong>
                  <span id="imgCombineOutMeta">—</span>
                </div>

                <div class="nid-sheet-stage">
                  <img id="imgCombineOutPreview" alt="জোড়া লাগানো ছবির প্রিভিউ" width="420" height="594">
                </div>

                <div class="nid-layout-controls">
                  <fieldset class="pdf-fieldset">
                    <legend class="pdf-legend">পেজ লেআউট:</legend>
                    <div class="pdf-radio-inline">
                      <label class="dc-radio"><input type="radio" name="imgCombineMode" value="nid-a4" checked> A4 শিট (উপরে-নিচে)</label>
                      <label class="dc-radio"><input type="radio" name="imgCombineMode" value="nid-a4-side"> A4 শিট (পাশাপাশি)</label>
                      <label class="dc-radio"><input type="radio" name="imgCombineMode" value="vertical"> শুধু কার্ড (উপরে-নিচে)</label>
                      <label class="dc-radio"><input type="radio" name="imgCombineMode" value="horizontal"> শুধু কার্ড (পাশাপাশি)</label>
                    </div>
                  </fieldset>

                  <div class="nid-size-presets" id="nidSizePresets">
                    <span class="pdf-legend" style="margin:0;">কার্ডের সাইজ প্রিসেট:</span>
                    <button type="button" class="chip-btn" data-cardw="520">আসল NID মাপ (85.6×54mm)</button>
                    <button type="button" class="chip-btn chip-btn--accent" data-cardw="660">স্ট্যান্ডার্ড ফটোকপি</button>
                    <button type="button" class="chip-btn" data-cardw="800">বড় প্রিন্ট</button>
                  </div>

                  <div class="pdf-img-settings img-grid-4" style="margin-top: .65rem;">
                    <div class="pdf-field-group">
                      <label for="imgCombineCardW">কার্ড প্রস্থ (px):</label>
                      <input type="number" id="imgCombineCardW" name="imgCombineCardW" value="660" min="300" max="1120" step="20">
                    </div>
                    <div class="pdf-field-group">
                      <label for="imgCombineGap">মাঝের ফাঁকা (Gap):</label>
                      <input type="number" id="imgCombineGap" name="imgCombineGap" value="36" min="0" max="240">
                    </div>
                    <div class="pdf-field-group">
                      <label for="imgCombineAlign">A4 পাতায় অবস্থান:</label>
                      <select id="imgCombineAlign" name="imgCombineAlign">
                        <option value="top" selected>উপরে মাঝখানে (ফটোকপি স্ট্যান্ডার্ড)</option>
                        <option value="center">একদম মাঝখানে (Center)</option>
                      </select>
                    </div>
                    <div class="pdf-field-group">
                      <label for="imgCombineCopies">পাতায় কপি সংখ্যা:</label>
                      <select id="imgCombineCopies" name="imgCombineCopies">
                        <option value="1" selected>১ সেট (সাধারণ)</option>
                        <option value="2">২ সেট (এক পাতায় ২ জোড়া)</option>
                        <option value="4">৪ সেট (এক পাতায় ৪ জোড়া)</option>
                      </select>
                    </div>
                  </div>

                  <div class="img-controls-row" style="margin-top: .65rem; justify-content: space-between;">
                    <div class="img-color-row">
                      <label for="imgCombineBg" style="font-size:.8rem; font-weight:700;">পাতার রঙ:</label>
                      <input type="color" id="imgCombineBg" name="imgCombineBg" value="#ffffff">
                    </div>
                    <label class="switch pdf-inline-switch">
                      <input type="checkbox" id="imgCombineRoundCorner" name="imgCombineRoundCorner" checked>
                      <span class="switch__track"><span class="switch__knob"></span></span>
                      <span class="switch__label">রাউন্ডেড কোণা</span>
                    </label>
                    <label class="switch pdf-inline-switch">
                      <input type="checkbox" id="imgCombineCardBorder" name="imgCombineCardBorder" checked>
                      <span class="switch__track"><span class="switch__knob"></span></span>
                      <span class="switch__label">কার্ড বর্ডার</span>
                    </label>
                    <label class="switch pdf-inline-switch">
                      <input type="checkbox" id="imgCombineCutMarks" name="imgCombineCutMarks">
                      <span class="switch__track"><span class="switch__knob"></span></span>
                      <span class="switch__label">কাটিং মার্ক</span>
                    </label>
                  </div>
                </div>

                <div class="pdf-action-bar nid-studio-actions">
                  <div class="pdf-summary-pill" id="imgCombineSummary">প্রস্তুত</div>
                  <div class="img-download-group" style="display:flex; gap:.5rem; flex-wrap:wrap;">
                    <button type="button" class="btn btn--primary pdf-main-action" id="imgCombineDownloadBtn">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
                      JPG ডাউনলোড
                    </button>
                    <button type="button" class="btn btn--primary pdf-main-action" id="imgCombineDownloadPdfBtn">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M12 18v-6m0 6-3-3m3 3 3-3"/></svg>
                      PDF ডাউনলোড
                    </button>
                    <button type="button" class="chip-btn chip-btn--accent" id="imgCombinePrintBtn" style="padding:.55rem .9rem; font-weight:800;">
                      🖨 প্রিন্ট
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ========================================== 6. COLOR PICKER & PALETTE -->
      <div class="img-pane" id="img-pane-colors" hidden={initialTab !== 'colors'}>
        <div class="pdf-ws-head">
          <div>
            <h3 class="pdf-ws-title">কালার পিকার ও প্যালেট জেনারেটর</h3>
          </div>
          <div class="pdf-ws-actions" id="imgColorsTopActions" hidden>
            <button type="button" class="chip-btn chip-btn--danger" id="imgColorsResetBtn">অন্য ছবি নিন</button>
          </div>
        </div>

        <label class="pdf-dropzone" id="imgColorsDropzone" for="imgColorsInput">
          <input type="file" id="imgColorsInput" name="imgColorsInput" accept="image/*" class="visually-hidden">
          <div class="pdf-dropzone__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2a10 10 0 1 0 0 20 2 2 0 0 0 2-2v-.5a1.5 1.5 0 0 1 1.5-1.5H17a5 5 0 0 0 5-5c0-5.5-4.5-11-10-11z"/></svg>
          </div>
          <div class="pdf-dropzone__title">রঙ বাছাই করার জন্য একটি ছবি ছাড়ুন বা <span class="link-ish">সিলেক্ট করুন</span></div>
          <div class="pdf-dropzone__sub">লোগো, ব্যানার বা ফটো থেকে নিখুঁত HEX এবং RGB কোড বের করুন</div>
        </label>

        <div class="pdf-workspace-stage" id="imgColorsStage" hidden>
          <div class="img-color-picker-layout">
            <div class="img-color-canvas-wrap">
              <canvas id="imgColorsCanvas"></canvas>
            </div>
            <div class="img-color-side">
              <div class="pdf-options-box">
                <div class="img-picked-swatch" id="imgPickedSwatch" style="background: #059669;"></div>
                <div class="img-picked-codes">
                  <button type="button" class="chip-btn" id="imgCopyHexBtn" title="HEX কোড কপি করুন">
                    HEX: <strong id="imgPickedHex">#059669</strong> 📋
                  </button>
                  <button type="button" class="chip-btn" id="imgCopyRgbBtn" title="RGB কোড কপি করুন">
                    RGB: <strong id="imgPickedRgb">rgb(5, 150, 105)</strong> 📋
                  </button>
                </div>
              </div>

              <div class="pdf-options-box" style="margin-top: .85rem;">
                <strong style="display:block; font-size:.86rem; margin-bottom:.55rem;">ছবির প্রধান রঙের প্যালেট (ক্লিক করে কপি করুন):</strong>
                <div class="img-palette-grid" id="imgPaletteGrid"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Before / After Image Quality Comparison Dialog -->
  <dialog class="pdf-dialog pdf-dialog--wide" id="imgPreviewDialog" closedby="any" aria-labelledby="imgPreviewTitle">
    <div class="pdf-dialog__head">
      <div>
        <h3 class="pdf-dialog__title" id="imgPreviewTitle">আগে ও পরে তুলনা</h3>
        <p class="pdf-dialog__sub" id="imgPreviewSub"></p>
      </div>
      <div class="pdf-ws-actions">
        <button type="button" class="ai-close pdf-dialog__close" id="imgPreviewClose" aria-label="বন্ধ করুন">✕</button>
      </div>
    </div>
    <div class="pdf-dialog__body">
      <div class="pdf-preview-stage" id="imgPreviewStage"></div>
    </div>
  </dialog>

  <!-- Live Camera Capture Dialog -->
  <dialog class="pdf-dialog" id="nidCameraDialog" closedby="any" aria-labelledby="nidCameraTitle">
    <div class="pdf-dialog__head">
      <div>
        <h3 class="pdf-dialog__title" id="nidCameraTitle">আইডি কার্ড ক্যামেরা স্ক্যানার</h3>
      </div>
      <div class="pdf-ws-actions">
        <button type="button" class="ai-close pdf-dialog__close" id="nidCameraClose" aria-label="বন্ধ করুন">✕</button>
      </div>
    </div>
    <div class="pdf-dialog__body">
      <div class="nid-cam-viewfinder">
        <video id="nidCameraVideo" width="640" height="400" autoplay playsinline muted></video>
        <div class="nid-cam-guide" aria-hidden="true">
          <span>আইডি কার্ড এই ফ্রেমের ভেতর রাখুন</span>
        </div>
      </div>
      <div class="pdf-action-bar" style="margin-top: .85rem;">
        <button type="button" class="chip-btn" id="nidCameraSwitchBtn">🔄 ক্যামেরা পরিবর্তন</button>
        <button type="button" class="btn btn--primary" id="nidCameraSnapBtn">📸 ছবি তুলুন ও অটো-ক্রপ করুন</button>
      </div>
    </div>
  </dialog>
</div>
