                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 18h20M6 14l12-6"/></svg>
                        <strong class="nid-angle-badge" id="nidFineAngleVal">০°</strong>
                      </label>
                      <input type="range" id="nidFineAngle" name="nidFineAngle" min="-15" max="15" step="0.5" value="0" class="nid-deskew-range" aria-label="সূক্ষ্ম কোণ (Straighten)">
                      <button type="button" class="chip-btn nid-dock-btn" id="nidFineAngleReset" title="কোণ ০ ডিগ্রিতে রিসেট করুন">০°</button>
                    </div>
                  </div>

                  <!-- Main Interactive 4-Corner Perspective Canvas Stage with Studio Rulers -->
                  <div class="nid-crop-canvas-shell" id="nidCanvasViewport" tabindex="0" aria-label="এডিটিং ক্যানভাস। Ctrl প্লাস বা মাইনাস দিয়ে জুম, Space ধরে টেনে সরান।">
                    <div class="th-canvas-ruler th-canvas-ruler--h" aria-hidden="true"></div>
                    <div class="th-canvas-ruler th-canvas-ruler--v" aria-hidden="true"></div>

                    <div class="nid-canvas-zoom-plane" id="nidCanvasZoomPlane">
                      <div
                        class="img-crop-stage-wrap nid-perspective-stage"
                        id="nidCropInteractiveWrap"
                        tabindex="0"
                        aria-label="আইডি কার্ড পার্সপেক্টিভ ক্রপ — চার কোণার বিন্দু টেনে বাঁকা কার্ড সোজা করে ক্রপ করুন"
                      >
                        <canvas id="nidCropSourceCanvas"></canvas>
                        <div class="nid-scan-beam" id="nidScanBeam" hidden aria-hidden="true"></div>
                        <svg class="nid-quad-svg" id="nidQuadSvg" viewBox="0 0 100 100" aria-hidden="true">
                          <defs>
                            <mask id="nidQuadMask">
                              <rect id="nidQuadMaskBg" x="0" y="0" width="100" height="100" fill="white" />
                              <polygon id="nidQuadHole" points="10,10 90,10 90,90 10,90" fill="black" />
                            </mask>
                          </defs>
                          <rect id="nidQuadDimRect" x="0" y="0" width="100" height="100" fill="rgba(9, 13, 22, 0.62)" mask="url(#nidQuadMask)" />
                          <line id="nidGridH1" class="nid-quad-grid" x1="10" y1="36" x2="90" y2="36" />
                          <line id="nidGridH2" class="nid-quad-grid" x1="10" y1="63" x2="90" y2="63" />
                          <line id="nidGridV1" class="nid-quad-grid" x1="36" y1="10" x2="36" y2="90" />
                          <line id="nidGridV2" class="nid-quad-grid" x1="63" y1="10" x2="63" y2="90" />
                          <line id="nidSnapGuideH" class="nid-snap-guide" x1="0" y1="0" x2="0" y2="0" hidden />
                          <line id="nidSnapGuideV" class="nid-snap-guide" x1="0" y1="0" x2="0" y2="0" hidden />
                          <polygon id="nidQuadPoly" class="nid-quad-poly" points="10,10 90,10 90,90 10,90" />
                        </svg>
                        <div class="nid-quad-handles" id="nidQuadHandles">
                          <button type="button" class="nid-quad-handle nid-quad-handle--corner" data-pt="0" aria-label="উপরের বাম কোণা"></button>
                          <button type="button" class="nid-quad-handle nid-quad-handle--corner" data-pt="1" aria-label="উপরের ডান কোণা"></button>
                          <button type="button" class="nid-quad-handle nid-quad-handle--corner" data-pt="2" aria-label="নিচের ডান কোণা"></button>
                          <button type="button" class="nid-quad-handle nid-quad-handle--corner" data-pt="3" aria-label="নিচের বাম কোণা"></button>
                          <button type="button" class="nid-quad-handle nid-quad-handle--edge" data-edge="0" aria-label="উপরের ধার"></button>
                          <button type="button" class="nid-quad-handle nid-quad-handle--edge" data-edge="1" aria-label="ডান ধার"></button>
                          <button type="button" class="nid-quad-handle nid-quad-handle--edge" data-edge="2" aria-label="নিচের ধার"></button>
                          <button type="button" class="nid-quad-handle nid-quad-handle--edge" data-edge="3" aria-label="বাম ধার"></button>
                        </div>
                        <canvas class="nid-crop-loupe" id="nidCropLoupe" width="116" height="116" hidden aria-hidden="true"></canvas>
                      </div>
                    </div>
                  </div>

                  <!-- Bottom Studio Status & Zoom Bar -->
                  <div class="th-canvas-statusbar">
                    <div class="th-status-left">
                      <div class="th-zoom-controls" role="group" aria-label="ক্যানভাস জুম">
                        <button type="button" class="th-status-btn" id="nidZoomOutBtn" title="জুম আউট (−)">−</button>
                        <label class="nid-zoom-input"><input type="number" id="nidZoomPercent" min="1" max="800" step="1" value="100" aria-label="ক্যানভাস জুম শতাংশ"><span>%</span></label>
                        <button type="button" class="th-status-btn" id="nidZoomInBtn" title="জুম ইন (+)">+</button>
                      </div>
                      <button type="button" class="th-status-btn" id="nidZoomFitBtn" title="স্ক্রিনে ফিট করুন (Ctrl+0)">Fit</button>
                      <button type="button" class="th-status-btn" id="nidZoomResetBtn" title="আসল পিক্সেল সাইজ (Ctrl+1)">100%</button>
                      <button type="button" class="th-status-btn" id="nidHandToolBtn" aria-pressed="false" title="হ্যান্ড টুল (H)। ক্রপে ফিরতে V চাপুন।">হ্যান্ড</button>
                      <span class="th-status-sep" aria-hidden="true"></span>
                      <button type="button" class="th-status-btn active" id="nidToggleGridBtn" aria-pressed="true" title="গ্রিড লাইন চালু/বন্ধ করুন">গ্রিড</button>
                    </div>

                    <p class="nid-shortcut-hint"><kbd>Ctrl + / −</kbd> জুম · <kbd>Alt + Scroll</kbd> জুম · <kbd>Space + Drag</kbd> প্যান</p>
                  </div>
                </div>

                <!-- Print Preview Stage (Full-Height Preview Window Column) -->
                <section class="nid-workspace-preview" id="nidPreviewPanel" aria-label="বড় প্রিন্ট প্রিভিউ">
                  <div class="th-section-head nid-sheet-panel__head">
                    <strong class="th-section-title">প্রিন্ট প্রিভিউ</strong><span class="nid-paper-label" id="nidPaperLabel">A4 · 210 × 297 mm</span>
                    <span class="nid-meta-pill" id="imgCombineOutMeta">—</span>
                  </div>

                  <div class="nid-sheet-stage">
                    <img id="imgCombineOutPreview" alt="জোড়া লাগানো ছবির প্রিভিউ" width="420" height="594">
                  </div>

                  <div class="nid-export-summary">
                    <span class="nid-export-dot" aria-hidden="true"></span>
                    <span id="imgCombineSummary" role="status">প্রস্তুত</span>
                  </div>
                </section>
              </div>
            </div>

            <!-- ========================================== PANEL 3: RIGHT PROPERTIES & PRINT PREVIEW -->
            <aside class="th-panel th-panel--right nid-sheet-panel" id="nidPrintPanel" aria-label="পেজ সেটআপ ও ডাউনলোড">
              <div class="th-right-scroll">
                <!-- Collapsible Print Settings Accordions -->
                <div class="nid-layout-controls">
                  <details class="th-prop-acc" open>
                    <summary class="th-prop-acc__head">
                      <span>পেজ লেআউট</span>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div class="th-prop-acc__body">
                      <fieldset class="pdf-fieldset nid-fieldset-clean">
                        <legend class="visually-hidden">পেজ লেআউট</legend>
                        <div class="nid-layout-pills">
                          <label class="nid-pill-option">
                            <input type="radio" name="imgCombineMode" value="nid-a4" checked>
                            <span class="nid-pill-option__label">A4 (উপরে-নিচে)</span>
                          </label>
                          <label class="nid-pill-option">
                            <input type="radio" name="imgCombineMode" value="nid-a4-side">
                            <span class="nid-pill-option__label">A4 (পাশাপাশি)</span>
                          </label>
                          <label class="nid-pill-option">
                            <input type="radio" name="imgCombineMode" value="vertical">
                            <span class="nid-pill-option__label">কার্ড (উপরে-নিচে)</span>
                          </label>
                          <label class="nid-pill-option">
                            <input type="radio" name="imgCombineMode" value="horizontal">
                            <span class="nid-pill-option__label">কার্ড (পাশাপাশি)</span>
                          </label>
                        </div>
                      </fieldset>

                    </div>
                  </details>

                  <details class="th-prop-acc" open>
                    <summary class="th-prop-acc__head">
                      <span>কপি সংখ্যা ও প্রিন্ট অপশন</span>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div class="th-prop-acc__body">
                      <div class="pdf-img-settings nid-settings-grid">
                        <div class="pdf-field-group">
                          <label for="imgCombineCopies">পাতায় কপি</label>
                          <select id="imgCombineCopies" name="imgCombineCopies">
                            <option value="1" selected>১ সেট (সাধারণ)</option>
                            <option value="2">২ সেট (২ জোড়া)</option>
                            <option value="4">৪ সেট (৪ জোড়া)</option>
                          </select>
                        </div>
                        <div class="pdf-field-group">
                          <label for="imgCombineAlign">পজিশন</label>
                          <select id="imgCombineAlign" name="imgCombineAlign">
                            <option value="top" selected>উপরে মাঝখানে</option>
                            <option value="center">একদম মাঝখানে</option>
                          </select>
                        </div>
                      </div>

                      <div class="nid-toggles-bar">
                        <label class="switch pdf-inline-switch">
                          <input type="checkbox" id="imgCombineRoundCorner" name="imgCombineRoundCorner" checked>
                          <span class="switch__track"><span class="switch__knob"></span></span>
                          <span class="switch__label">রাউন্ড কোণা</span>
                        </label>
                        <label class="switch pdf-inline-switch">
                          <input type="checkbox" id="imgCombineCardBorder" name="imgCombineCardBorder" checked>
                          <span class="switch__track"><span class="switch__knob"></span></span>
                          <span class="switch__label">বর্ডার</span>
                        </label>
                        <label class="switch pdf-inline-switch">
                          <input type="checkbox" id="imgCombineCutMarks" name="imgCombineCutMarks">
                          <span class="switch__track"><span class="switch__knob"></span></span>
                          <span class="switch__label">কাট মার্ক</span>
                        </label>
                      </div>
                    </div>
                  </details>

                  <details class="th-prop-acc">
                    <summary class="th-prop-acc__head">
                      <span>গ্যাপ ও পেজ কালার</span>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div class="th-prop-acc__body">
                      <div class="pdf-img-settings nid-settings-grid">
<div class="pdf-field-group">
                          <label for="imgCombineGap">মাঝের ফাঁকা (Gap)</label>
                          <input type="number" id="imgCombineGap" name="imgCombineGap" value="36" min="0" max="240">
                        </div>
                      </div>
                      <div class="img-color-row" style="margin-top:.35rem; justify-content:space-between;">
                        <label for="imgCombineBg" style="font-size:.72rem; font-weight:600; color:var(--th-text-sub);">ব্যাকগ্রাউন্ড পাতার রঙ</label>
                        <input type="color" id="imgCombineBg" name="imgCombineBg" value="#ffffff">
                      </div>
                    </div>
                  </details>
                </div>
              </div>

              <!-- Export Area: Primary (PDF), Secondary (Print), Tertiary (JPG) -->
              <div class="nid-export-bar">
                <button type="button" class="btn btn--primary nid-export-btn nid-export-btn--pdf" id="imgCombineDownloadPdfBtn">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M12 18v-6m0 6-3-3m3 3 3-3"/></svg>
                  <span>PDF ডাউনলোড করুন</span>
                </button>
                <div class="nid-export-secondary-row">
                  <button type="button" class="nid-export-btn nid-export-btn--print" id="imgCombinePrintBtn" title="সরাসরি প্রিন্ট করুন">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                    <span>প্রিন্ট করুন</span>
                  </button>
                  <button type="button" class="nid-export-btn nid-export-btn--jpg" id="imgCombineDownloadBtn" title="হাই-রেজোলিউশন JPG ইমেজ ডাউনলোড">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
                    <span>JPG ইমেজ</span>
                  </button>
                </div>
              </div>
            </aside>

          </div>
        </div>
      </div>

      <!-- ========================================== 6. COLOR PICKER & PALETTE -->
      <div class="img-pane" id="img-pane-colors" hidden={initialTab !== 'colors'}>
        <div class="pdf-ws-head">
          <div>
            <h3 class="pdf-ws-title">কালার পিকার ও প্যালেট জেনারেটর</h3>
          </div>
          <div class="pdf-ws-actions" id="imgColorsTopActions" hidden>
            <button type="button" class="chip-btn chip-btn--danger" id="imgColorsResetBtn">অন্য ছবি নিন</button>
          </div>
        </div>

        <label class="pdf-dropzone" id="imgColorsDropzone" for="imgColorsInput">
          <input type="file" id="imgColorsInput" name="imgColorsInput" accept="image/*" class="visually-hidden">
          <div class="pdf-dropzone__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2a10 10 0 1 0 0 20 2 2 0 0 0 2-2v-.5a1.5 1.5 0 0 1 1.5-1.5H17a5 5 0 0 0 5-5c0-5.5-4.5-11-10-11z"/></svg>
          </div>
          <div class="pdf-dropzone__title">রঙ বাছাই করার জন্য একটি ছবি ছাড়ুন বা <span class="link-ish">সিলেক্ট করুন</span></div>
          <div class="pdf-dropzone__sub">লোগো, ব্যানার বা ফটো থেকে নিখুঁত HEX এবং RGB কোড বের করুন</div>
        </label>

        <div class="pdf-workspace-stage" id="imgColorsStage" hidden>
          <div class="img-color-picker-layout">
            <div class="img-color-canvas-wrap">
              <canvas id="imgColorsCanvas"></canvas>
            </div>
            <div class="img-color-side">
              <div class="pdf-options-box">
                <div class="img-picked-swatch" id="imgPickedSwatch" style="background: #059669;"></div>
                <div class="img-picked-codes">
                  <button type="button" class="chip-btn" id="imgCopyHexBtn" title="HEX কোড কপি করুন">
                    HEX: <strong id="imgPickedHex">#059669</strong> 📋
                  </button>
                  <button type="button" class="chip-btn" id="imgCopyRgbBtn" title="RGB কোড কপি করুন">
                    RGB: <strong id="imgPickedRgb">rgb(5, 150, 105)</strong> 📋
                  </button>
                </div>
              </div>

              <div class="pdf-options-box" style="margin-top: .85rem;">
                <strong style="display:block; font-size:.86rem; margin-bottom:.55rem;">ছবির প্রধান রঙের প্যালেট (ক্লিক করে কপি করুন):</strong>
                <div class="img-palette-grid" id="imgPaletteGrid"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Before / After Image Quality Comparison Dialog -->
  <dialog class="pdf-dialog pdf-dialog--wide" id="imgPreviewDialog" closedby="any" aria-labelledby="imgPreviewTitle">
    <div class="pdf-dialog__head">
      <div>
        <h3 class="pdf-dialog__title" id="imgPreviewTitle">আগে ও পরে তুলনা</h3>
        <p class="pdf-dialog__sub" id="imgPreviewSub"></p>
      </div>
      <div class="pdf-ws-actions">
        <button type="button" class="ai-close pdf-dialog__close" id="imgPreviewClose" aria-label="বন্ধ করুন">✕</button>
      </div>
    </div>
    <div class="pdf-dialog__body">
      <div class="pdf-preview-stage" id="imgPreviewStage"></div>
    </div>
  </dialog>

  <!-- Live Camera Capture Dialog -->
  <dialog class="pdf-dialog" id="nidCameraDialog" closedby="any" aria-labelledby="nidCameraTitle">
    <div class="pdf-dialog__head">
      <div>
        <h3 class="pdf-dialog__title" id="nidCameraTitle">আইডি কার্ড ক্যামেরা স্ক্যানার</h3>
      </div>
      <div class="pdf-ws-actions">
        <button type="button" class="ai-close pdf-dialog__close" id="nidCameraClose" aria-label="বন্ধ করুন">✕</button>
      </div>
    </div>
    <div class="pdf-dialog__body">
      <div class="nid-cam-viewfinder">
        <video id="nidCameraVideo" width="640" height="400" autoplay playsinline muted></video>
        <div class="nid-cam-guide" aria-hidden="true">
          <span>আইডি কার্ড এই ফ্রেমের ভেতর রাখুন</span>
        </div>
      </div>
      <div class="pdf-action-bar" style="margin-top: .85rem;">
        <button type="button" class="chip-btn nid-icon-btn" id="nidCameraSwitchBtn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
          <span>ক্যামেরা পরিবর্তন</span>
        </button>
        <button type="button" class="btn btn--primary nid-icon-btn" id="nidCameraSnapBtn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>
          <span>ছবি তুলুন ও অটো-ক্রপ করুন</span>
        </button>
      </div>
    </div>
  </dialog>
</div>
