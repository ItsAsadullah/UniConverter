          </div>
        </div>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="mobRouteMeta" set:html={mobRouteMetaJson}></script>
  <script is:inline>
    (function () {
      if (window.__thMobShell) return;
      window.__thMobShell = true;
      var META = {};
      try { META = JSON.parse(document.getElementById('mobRouteMeta').textContent || '{}'); } catch (e) {}
      var CAT_FOR_PREFIX = { '/calendar': 'dates', '/age-calculator': 'dates', '/date-calculator': 'dates', '/dates': 'dates', '/invoice': 'utilities', '/business': 'utilities' };
      function norm(p) { p = (p || '/').split('?')[0].split('#')[0].replace(/\/+$/, ''); return p || '/'; }
      function isEn() { return document.documentElement.getAttribute('data-lang') === 'en'; }
      function catById(id) { return (META.cats || []).filter(function (c) { return c.id === (id === 'business' ? 'utilities' : id); })[0]; }

      /* Keep the native-style app bar + bottom tab bar in sync with the current route */
      function syncMobileShell() {
        var path = norm(location.pathname);
        var isHome = path === '/';
        var tools = META.tools || [];
        var aliasId = (META.alias || {})[path];
        var tool = tools.filter(function (t) { return aliasId ? t.id === aliasId : t.h === path; })[0];
        var cat = null;
        if (tool) cat = catById(tool.cat);
        if (!cat) cat = (META.cats || []).filter(function (c) { return c.href === path; })[0] || null;
        if (!cat) {
          var seg = '/' + (path.split('/')[1] || '');
          var cid = CAT_FOR_PREFIX[seg] || seg.slice(1);
          cat = catById(cid) || null;
        }
        var brand = document.querySelector('[data-mob-brand]');
        var back = document.getElementById('mobAppBarBack');
        var title = document.getElementById('mobAppBarTitle');
        if (brand) brand.hidden = !isHome;
        if (back) { back.hidden = isHome; back.setAttribute('href', tool && cat ? cat.href : '/'); }
        if (title) {
          title.hidden = isHome;
          var bnT = tool ? tool.bn : (cat ? cat.bn : 'TechHat Studio');
          var enT = tool ? tool.en : (cat ? cat.en : 'TechHat Studio');
          title.setAttribute('data-i18n-bn', bnT);
          title.setAttribute('data-i18n-en', enT);
          title.textContent = isEn() ? enT : bnT;
        }
        var active = isHome ? 'home' : ((cat && cat.id === 'pdf') ? 'pdf' : 'tools');
        document.querySelectorAll('[data-mob-tab]').forEach(function (a) {
          if (a.getAttribute('data-mob-tab') === active) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });
      }

      /* Track in-app (SPA) depth so the app-bar back arrow never leaves the site */
      var spaDepth = 0;
      var origPush = history.pushState;
      history.pushState = function () {
        var r = origPush.apply(this, arguments);
        spaDepth++;
        setTimeout(syncMobileShell, 0);
        return r;
      };
      window.addEventListener('popstate', function () {
        if (spaDepth > 0) spaDepth--;
        setTimeout(syncMobileShell, 0);
      });

      function openSheet(id) {
        var d = document.getElementById(id);
        if (d && !d.open) { try { d.showModal(); } catch (e) { d.setAttribute('open', ''); } }
      }
      function closeSheets() {
        document.querySelectorAll('dialog.th-mob-sheet[open]').forEach(function (d) { d.close(); });
      }
      function showMobAllTools(open) {
        var homeMain = document.getElementById('mobHomeMainView');
        var allTools = document.getElementById('mobAllTools');
        if (!allTools) return;
        if (homeMain) homeMain.hidden = !!open;
        allTools.hidden = !open;
        window.scrollTo({ top: 0, behavior: 'smooth' });
        var targetTab = open ? 'tools' : 'home';
        document.querySelectorAll('[data-mob-tab]').forEach(function (a) {
          if (a.getAttribute('data-mob-tab') === targetTab) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });
      }

      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t.closest) return;
        var opener = t.closest('[data-mob-sheet-open]');
        if (opener && opener.getAttribute('data-mob-sheet-open')) {
          e.preventDefault();
          var install = document.querySelector('[data-mob-install]'), deskInstall = document.getElementById('installBtn');
          if (install && deskInstall) install.hidden = deskInstall.hidden;
          openSheet(opener.getAttribute('data-mob-sheet-open'));
          return;
        }
        var sheet = t.closest('dialog.th-mob-sheet');
        if (sheet && (t === sheet || t.closest('[data-mob-sheet-close]'))) { sheet.close(); return; }
        if (t.closest('[data-mob-theme]')) { var tb = document.getElementById('themeToggle'); if (tb) tb.click(); return; }
        if (t.closest('[data-mob-install]')) { var ib = document.getElementById('installBtn'); if (ib) ib.click(); return; }

        if (t.closest('[data-mob-open-all-tools]')) {
          e.preventDefault();
          showMobAllTools(true);
          return;
        }
        if (t.closest('[data-mob-close-all-tools]')) {
          e.preventDefault();
          showMobAllTools(false);
          return;
        }

        var homeTabLink = t.closest('a[data-mob-tab="home"]');
        if (homeTabLink && norm(location.pathname) === '/') {
          var allToolsEl = document.getElementById('mobAllTools');
          if (allToolsEl && !allToolsEl.hidden) {
            e.preventDefault();
            showMobAllTools(false);
            return;
          }
        }

        var allToolsLink = t.closest('a[href="/#mobAllTools"]');
        if (allToolsLink) {
          e.preventDefault();
          closeSheets();
          if (norm(location.pathname) === '/') { showMobAllTools(true); return; }
          var nav = window.TechHatNavigate ? window.TechHatNavigate('/') : null;
          if (nav && nav.then) nav.then(function () { setTimeout(function () { showMobAllTools(true); }, 60); });
          else location.href = '/#mobAllTools';
          return;
        }

        var back = t.closest('[data-mob-back]');
        if (back && spaDepth > 0) { e.preventDefault(); history.back(); return; }

        if (sheet && t.closest('a[href]')) closeSheets();
      });

      if (location.hash === '#mobAllTools') setTimeout(function () { showMobAllTools(true); }, 120);
      syncMobileShell();
    })();
  </script>

  <script is:inline src="/js/shell.js?v=71"></script>
  <slot name="scripts" />
