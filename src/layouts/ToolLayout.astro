---
import Icon from '../components/ui/Icon.svelte';
import { getToolMeta, CATEGORIES, ALL_TOOLS, getToolsByCategory, getToolIconPalette, type ToolMeta, type CategoryId } from '../data/tools';
import '../styles/studio-design.css';

interface Props {
  toolId?: ToolMeta['id'] | 'home' | CategoryId;
  title?: string;
  description?: string;
  activeBadgeText?: string;
  activeCategory?: CategoryId;
}

const { toolId = 'bijoy', title, description, activeCategory } = Astro.props;
const legacyToolIds = ['bijoy', 'pdf', 'image', 'calendar', 'age', 'datecalc', 'invoice'];
const currentTool = legacyToolIds.includes(toolId as string)
  ? getToolMeta(toolId as ToolMeta['id'])
  : getToolMeta('bijoy');

const pageTitle = title || (toolId === 'home'
  ? 'TechHat Studio — Document, PDF & Office Productivity Suite'
  : currentTool.seoTitle);
const pageDesc = description || currentTool.seoDesc;
const currentYear = String(new Date().getFullYear());

const rawCategory: CategoryId | undefined = activeCategory || (
  toolId === 'bijoy' ? 'bangla'
  : toolId === 'pdf' ? 'pdf'
  : toolId === 'image' ? 'image'
  : (toolId === 'calendar' || toolId === 'age' || toolId === 'datecalc') ? 'dates'
  : toolId === 'invoice' ? 'utilities'
  : undefined
);
const inferredCategory: CategoryId | undefined = rawCategory === 'business' ? 'utilities' : rawCategory;
const currentCategoryMeta = inferredCategory ? CATEGORIES.find((c) => c.id === inferredCategory) : undefined;

const cleanPath = (Astro.url.pathname || '/').replace(/\/+$/, '') || '/';
const ALIAS_ROUTE_TO_TOOL_ID: Record<string, string> = {
  '/calendar/age-calculator': 'age',
  '/calendar/date-calculator': 'datecalc',
  '/business/invoice-maker': 'invoice',
  '/image/scanner': 'image-scan'
};
const aliasToolId = ALIAS_ROUTE_TO_TOOL_ID[cleanPath];
const matchedCatalogTool = aliasToolId
  ? ALL_TOOLS.find((t) => t.id === aliasToolId)
  : ALL_TOOLS.find((t) => t.href === cleanPath);

// Native-app style mobile shell (< 1024px): app bar title, back target & active bottom tab
const isHome = toolId === 'home';
const mobTitleBn = matchedCatalogTool?.title || currentCategoryMeta?.title || 'TechHat Studio';
const mobTitleEn = matchedCatalogTool?.titleEn || currentCategoryMeta?.titleEn || 'TechHat Studio';
const mobBackHref = matchedCatalogTool && currentCategoryMeta ? currentCategoryMeta.href : '/';
const mobActiveTab = isHome ? 'home' : (currentCategoryMeta?.id === 'pdf' ? 'pdf' : 'tools');
const MOB_SCAN_ACTIONS = [
  { href: '/image/scan', icon: 'lucide:scan', bn: 'ডকুমেন্ট স্ক্যান', en: 'Document Scan', subBn: 'কাগজ, রসিদ, সার্টিফিকেট', subEn: 'Paper, receipts, certificates', grad: 'from-blue-500 to-indigo-600' },
  { href: '/image/combine', icon: 'lucide:id-card', bn: 'আইডি কার্ড', en: 'ID Card', subBn: 'সামনে ও পেছনে এক পাতায়', subEn: 'Front & back on one page', grad: 'from-cyan-500 to-teal-600' },
  { href: '/image/passport', icon: 'lucide:book-open', bn: 'পাসপোর্ট', en: 'Passport', subBn: '৬-পয়েন্ট ভাঁজ ক্রপ', subEn: '6-point fold crop', grad: 'from-emerald-500 to-green-600' },
  { href: '/pdf/other-to-pdf', icon: 'lucide:image-up', bn: 'ছবি থেকে PDF', en: 'Images to PDF', subBn: 'গ্যালারি থেকে ইমপোর্ট', subEn: 'Import from gallery', grad: 'from-rose-500 to-pink-600' }
];
// Client-side route map so the mobile app bar stays in sync during SPA (workbench-only) navigation
const MOB_ROUTE_META = {
  cats: CATEGORIES.map((c) => ({ id: c.id, href: c.href, bn: c.title, en: c.titleEn })),
  tools: ALL_TOOLS.flatMap((t) => [t.href, ...(t.aliases || [])].map((h) => ({ h, id: t.id, bn: t.title, en: t.titleEn, cat: t.categoryId }))),
  alias: ALIAS_ROUTE_TO_TOOL_ID
};
const mobRouteMetaJson = JSON.stringify(MOB_ROUTE_META);
---
<!doctype html>
<html lang="bn" data-lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('thbc-theme') || localStorage.getItem('color-scheme');
        var theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        var meta = document.querySelector('meta[name="color-scheme"]');
        if (meta) meta.content = theme;

        var defaultLang = location.pathname.indexOf('/image/scan') === 0 ? 'en' : 'bn';
        var savedLang = localStorage.getItem('thbc-lang') || localStorage.getItem('thbc-scan-lang') || defaultLang;
        var lang = savedLang === 'en' ? 'en' : 'bn';
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.lang = lang;

        var prevVer = localStorage.getItem('thbc-cache-ver');
        if (prevVer !== 'v56') {
          localStorage.setItem('thbc-cache-ver', 'v56');
          var hadStale = false;
          var p = [];
          if (window.caches) {
            p.push(caches.keys().then(function (ks) {
              if (ks.length) hadStale = true;
              return Promise.all(ks.map(function (k) { return caches.delete(k); }));
            }));
          }
          if ('serviceWorker' in navigator) {
            p.push(navigator.serviceWorker.getRegistrations().then(function (rs) {
              if (rs.length) hadStale = true;
              return Promise.all(rs.map(function (r) { return r.unregister(); }));
            }));
          }
          if (p.length) {
            Promise.all(p).then(function () { if (hadStale) location.reload(); });
          }
        }
      } catch (e) {}
    })();
  </script>
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <meta name="theme-color" content="#0e0e10">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" sizes="48x48" href="/icons/icon-48.png">
  <link rel="apple-touch-icon" href="/icons/icon-180.png">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Bengali:wght@400;500;600;700&family=Hind+Siliguri:wght@400;600;700&family=Noto+Serif+Bengali:wght@400;700&family=Anek+Bangla:wght@400;500;600;700&family=Tiro+Bangla:ital@0;1&family=Baloo+Da+2:wght@400;700&family=Galada&family=Atma:wght@400;700&family=Mina:wght@400;700&display=swap">
</head>
<body
  data-astro-mpa="1"
  data-active-tool={toolId}
  class="min-h-screen flex flex-col overflow-x-clip bg-slate-50 dark:bg-studio-bg text-slate-900 dark:text-studio-text antialiased selection:bg-emerald-500/20"
>
  <!-- ============================================================ NATIVE-APP MOBILE APP BAR (< 1024px ONLY) -->
  <header
    id="mobAppBar"
    class="lg:hidden sticky top-0 z-50 bg-white/95 dark:bg-studio-sidebar/95 backdrop-blur-md border-b border-slate-200/80 dark:border-studio-border pt-[env(safe-area-inset-top)]"
  >
    <div class="h-14 px-2 flex items-center gap-1.5">
      <a href="/" data-mob-brand hidden={!isHome} class="[&[hidden]]:hidden inline-flex items-center gap-2 pl-1.5 no-underline text-slate-900 dark:text-studio-text min-w-0 flex-1" aria-label="TechHat Studio">
        <img class="w-8 h-8 rounded-xl shrink-0 shadow-xs" src="/icons/icon-48.png" width="32" height="32" decoding="async" alt="">
        <span class="text-[17px] font-extrabold tracking-tight whitespace-nowrap truncate">
          TechHat <b class="text-emerald-600 dark:text-studio-primary font-extrabold">Studio</b>
        </span>
      </a>
      <a
        href={mobBackHref}
        id="mobAppBarBack"
        data-mob-back
        hidden={isHome}
        class="[&[hidden]]:hidden inline-flex items-center justify-center w-10 h-10 rounded-full text-slate-700 dark:text-studio-text no-underline active:bg-slate-200/70 dark:active:bg-white/10 shrink-0"
        aria-label="Back"
      >
        <Icon name="lucide:arrow-left" class="w-5.5 h-5.5" />
      </a>
      <div
        id="mobAppBarTitle"
        hidden={isHome}
        class="[&[hidden]]:hidden flex-1 min-w-0 m-0 text-[16.5px] font-bold text-slate-900 dark:text-studio-text truncate"
        data-i18n-bn={mobTitleBn}
        data-i18n-en={mobTitleEn}
      >
        {mobTitleBn}
      </div>
      <button
        type="button"
        data-open-search
        class="inline-flex items-center justify-center w-10 h-10 rounded-full text-slate-700 dark:text-studio-text bg-transparent border-0 active:bg-slate-200/70 dark:active:bg-white/10 cursor-pointer shrink-0"
        aria-label="Search tools"
      >
        <Icon name="lucide:search" class="w-5 h-5" />
      </button>
      <button
        type="button"
        data-mob-sheet-open="mobMeSheet"
        class="inline-flex items-center justify-center w-10 h-10 rounded-full text-slate-700 dark:text-studio-text bg-transparent border-0 active:bg-slate-200/70 dark:active:bg-white/10 cursor-pointer shrink-0"
        aria-label="Settings"
      >
        <Icon name="lucide:settings-2" class="w-5 h-5" />
      </button>
    </div>
  </header>

  <!-- ============================================================ GLOBAL HEADER (DESKTOP ≥ 1024px) -->
  <header class="max-lg:hidden sticky top-0 z-50 bg-white/95 dark:bg-studio-sidebar/95 backdrop-blur-md border-b border-slate-200 dark:border-studio-border shadow-2xs">
    <div class="w-full h-14 sm:h-16 px-3 sm:px-6 lg:px-10 flex items-center justify-between gap-2 sm:gap-4">
      <a class="inline-flex items-center gap-2 sm:gap-2.5 no-underline text-slate-900 dark:text-studio-text min-w-0 shrink" href="/" aria-label="TechHat Studio">
        <img class="w-8 h-8 rounded-lg shrink-0" src="/icons/icon-48.png" width="32" height="32" decoding="async" alt="">
        <span class="text-base sm:text-lg font-extrabold tracking-tight whitespace-nowrap max-[359px]:hidden">
          TechHat <b class="text-emerald-600 dark:text-studio-primary font-extrabold max-[419px]:hidden">Studio</b>
        </span>
      </a>

      <!-- Desktop Category Dropdown Navigation (5 Primary Studios) -->
      <nav class="hidden lg:flex items-center gap-1.5" aria-label="Primary Navigation" id="desktopPrimaryNav">
        {CATEGORIES.map((cat) => {
          const items = getToolsByCategory(cat.id);
          const isActive = inferredCategory === cat.id;
          const catPal = getToolIconPalette(cat.color);
          return (
            <div class="relative group" data-nav-group={cat.id}>
              <a
                href={cat.href}
                data-nav-cat={cat.id}
                class:list={[
                  'th-nav-link inline-flex items-center gap-2 h-10 px-3.5 rounded-xl text-sm font-bold no-underline whitespace-nowrap transition-colors text-slate-700 dark:text-studio-muted hover:bg-slate-100 dark:hover:bg-studio-panel hover:text-slate-950 dark:hover:text-studio-text [&.is-active]:bg-emerald-500/12 dark:[&.is-active]:bg-studio-surface [&.is-active]:text-emerald-600 dark:[&.is-active]:text-studio-text dark:[&.is-active]:border dark:[&.is-active]:border-studio-border [&.is-active]:hover:bg-emerald-500/15 dark:[&.is-active]:hover:bg-studio-surface',
                  isActive && 'is-active'
                ]}
              >
                <Icon name={cat.lucideIcon} class={`w-4 h-4 shrink-0 ${catPal.text}`} />
                <span data-i18n-bn={cat.title} data-i18n-en={cat.titleEn}>{cat.title}</span>
              </a>
              <div
                class="th-nav-dropdown absolute top-full left-0 pt-1.5 w-72 opacity-0 invisible pointer-events-none group-hover:opacity-100 group-hover:visible group-hover:pointer-events-auto z-50"
                role="menu"
                aria-label={cat.titleEn}
              >
                <div class="p-2 rounded-2xl bg-white dark:bg-studio-sidebar border border-slate-200 dark:border-studio-border shadow-xl">
                  {items.map((item) => {
                    const itemPal = getToolIconPalette(item.color);
                    return (
                      <a
                        href={item.href}
                        aria-label={item.titleEn}
                        class="flex items-center gap-3 px-3 py-2.5 rounded-xl no-underline text-slate-900 dark:text-studio-text hover:bg-slate-100 dark:hover:bg-studio-panel transition-colors"
                        role="menuitem"
                      >
                        <span class={`w-8 h-8 rounded-lg ${itemPal.iconWrap} inline-flex items-center justify-center shrink-0`}>
                          <Icon name={item.lucideIcon} class="w-4 h-4" />
                        </span>
                        <span class="flex flex-col min-w-0">
                          <b class="text-sm font-bold leading-tight truncate" data-i18n-bn={item.title} data-i18n-en={item.titleEn}>{item.title}</b>
                          <small class="text-xs text-slate-500 dark:text-studio-muted truncate mt-0.5" data-i18n-bn={item.desc} data-i18n-en={item.descEn}>{item.desc}</small>
                        </span>
                      </a>
                    );
                  })}
                </div>
              </div>
            </div>
          );
        })}
      </nav>

      <!-- Header Right Actions (Clean & Minimal: Language + Theme + Mobile Trigger) -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <button class="chip-btn" id="btnCalReset" type="button" hidden={toolId !== 'calendar'} data-i18n-title-bn="আজকের তারিখ" data-i18n-title-en="Today">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3M18 3v4h-4M6 21v-4h4"/></svg>
          <span data-i18n-bn="আজ" data-i18n-en="Today">আজ</span>
        </button>

        <!-- UNIVERSAL LANGUAGE SWITCHER (বাংলা ⇄ EN) -->
        <div class="inline-flex items-center h-9.5 p-0.5 rounded-xl bg-slate-100 dark:bg-studio-panel border border-slate-200 dark:border-studio-border" id="globalLangSwitch" role="group" aria-label="Language Switcher">
          <button type="button" class="th-lang-btn is-active h-8 px-2 sm:px-3 border-0 rounded-md bg-transparent text-slate-600 dark:text-studio-muted text-xs font-bold cursor-pointer transition-colors hover:text-slate-900 dark:hover:text-studio-text [&.is-active]:bg-white dark:[&.is-active]:bg-studio-surface [&.is-active]:text-slate-900 dark:[&.is-active]:text-studio-text [&.is-active]:shadow-2xs" data-set-lang="bn" aria-pressed="true">বাংলা</button>
          <button type="button" class="th-lang-btn h-8 px-2 sm:px-3 border-0 rounded-md bg-transparent text-slate-600 dark:text-studio-muted text-xs font-bold cursor-pointer transition-colors hover:text-slate-900 dark:hover:text-studio-text [&.is-active]:bg-white dark:[&.is-active]:bg-studio-surface [&.is-active]:text-slate-900 dark:[&.is-active]:text-studio-text [&.is-active]:shadow-2xs" data-set-lang="en" aria-pressed="false">EN</button>
        </div>

        <button
          class="inline-flex items-center justify-center w-9.5 h-9.5 rounded-xl border border-slate-200 dark:border-studio-border bg-slate-100/80 dark:bg-studio-panel text-slate-600 dark:text-studio-muted cursor-pointer hover:text-slate-900 dark:hover:text-studio-text transition-colors theme-toggle"
          id="themeToggle"
          type="button"
          aria-label="Toggle theme"
          title="Toggle Light / Dark theme"
        >
          <svg class="theme-toggle__moon w-4.5 h-4.5 text-slate-700 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor" fill-opacity="0.16" stroke="none"/><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
          <svg class="theme-toggle__sun w-4.5 h-4.5 text-amber-400 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor" fill-opacity="0.22" stroke="none"/><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>

        <button class="inline-flex [&[hidden]]:hidden items-center justify-center w-9.5 h-9.5 rounded-xl border border-slate-200 dark:border-studio-border bg-slate-100/80 dark:bg-studio-panel text-slate-600 dark:text-studio-muted cursor-pointer" id="installBtn" type="button" hidden title="Install App">
          <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14"/></svg>
        </button>

        <button
          type="button"
          class="lg:hidden inline-flex items-center justify-center w-9.5 h-9.5 rounded-xl border border-slate-200 dark:border-studio-border bg-slate-100 dark:bg-studio-panel text-slate-800 dark:text-studio-text cursor-pointer"
          id="openMobileMenuBtn"
          aria-label="Open menu"
          title="Menu"
        >
          <Icon name="lucide:menu" class="w-4.5 h-4.5" aria-hidden="true" />
        </button>
      </div>
    </div>
  </header>

  <!-- ============================================================ MAIN WORKBENCH -->
  <main id="workbench" class="workbench flex-1 w-full max-w-none mx-auto px-4 sm:px-6 lg:px-10 pt-3 pb-8 max-lg:px-3 max-lg:pb-[calc(6rem+env(safe-area-inset-bottom))]">
    {toolId !== 'home' && currentCategoryMeta && (
      <nav
        id="globalBreadcrumbBar"
        aria-label="Breadcrumb"
        class="max-lg:hidden flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-studio-muted pt-0.5 pb-2 select-none"
      >
        <a
          href="/"
          class="inline-flex items-center gap-1 text-slate-500 dark:text-studio-muted hover:text-emerald-600 dark:hover:text-studio-primary no-underline transition-colors"
        >
          <Icon name="lucide:home" class="w-3.5 h-3.5 opacity-80" aria-hidden="true" />
          <span data-i18n-bn="হোম" data-i18n-en="Home">হোম</span>
        </a>
        <span class="text-slate-300 dark:text-slate-600" aria-hidden="true">/</span>
        <a
          href={currentCategoryMeta.href}
          id="globalBreadcrumbCat"
          class:list={[
            'hover:text-emerald-600 dark:hover:text-studio-primary no-underline transition-colors',
            matchedCatalogTool
              ? 'text-slate-500 dark:text-studio-muted'
              : 'text-slate-800 dark:text-studio-text font-semibold'
          ]}
          data-i18n-bn={currentCategoryMeta.title}
          data-i18n-en={currentCategoryMeta.titleEn}
        >
          {currentCategoryMeta.title}
        </a>
        <span
          id="globalBreadcrumbSep"
          class="text-slate-300 dark:text-slate-600"
          aria-hidden="true"
          hidden={!matchedCatalogTool}
        >/</span>
        <div
          id="globalBreadcrumbToolWrap"
          class="relative group/bc inline-flex items-center"
          hidden={!matchedCatalogTool}
        >
          <button
            type="button"
            id="globalBreadcrumbToolBtn"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white dark:bg-studio-sidebar border border-slate-200/90 dark:border-studio-border text-slate-800 dark:text-studio-text hover:border-emerald-500/60 dark:hover:border-studio-primary/60 hover:text-emerald-600 dark:hover:text-studio-primary text-xs font-bold shadow-2xs cursor-pointer transition-all"
            aria-haspopup="menu"
            aria-expanded="false"
          >
            <span
              id="globalBreadcrumbTool"
              class="truncate"
              data-i18n-bn={matchedCatalogTool ? matchedCatalogTool.title : ''}
              data-i18n-en={matchedCatalogTool ? matchedCatalogTool.titleEn : ''}
            >
              {matchedCatalogTool ? matchedCatalogTool.title : ''}
            </span>
            <Icon
              name="lucide:chevron-down"
              class="w-3.5 h-3.5 text-slate-400 group-hover/bc:text-emerald-600 dark:group-hover/bc:text-studio-primary transition-transform duration-150 group-[.is-open]/bc:rotate-180 group-hover/bc:rotate-180"
              aria-hidden="true"
            />
          </button>

          <div
            id="globalBreadcrumbDropdown"
            class="th-nav-dropdown absolute top-full left-0 max-sm:left-auto max-sm:right-0 pt-1.5 w-60 max-w-[calc(100vw-1.5rem)] opacity-0 invisible pointer-events-none group-hover/bc:opacity-100 group-hover/bc:visible group-hover/bc:pointer-events-auto group-[.is-open]/bc:opacity-100 group-[.is-open]/bc:visible group-[.is-open]/bc:pointer-events-auto transition-all duration-150 z-40"
            role="menu"
          >
            <div class="p-1.5 rounded-xl bg-white dark:bg-studio-sidebar border border-slate-200 dark:border-studio-border shadow-xl space-y-0.5">
              <a
                href={currentCategoryMeta.href}
                data-bc-item={currentCategoryMeta.href}
                aria-label={currentCategoryMeta.id === 'pdf' ? 'All PDF Tools' : currentCategoryMeta.id === 'image' ? 'All Image Tools' : `All ${currentCategoryMeta.titleEn}`}
                class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg no-underline text-xs font-semibold text-slate-600 dark:text-studio-muted hover:bg-slate-100 dark:hover:bg-studio-panel hover:text-slate-900 dark:hover:text-studio-text transition-colors"
                role="menuitem"
              >
                <Icon name="lucide:layout-grid" class="w-3.5 h-3.5 shrink-0 opacity-80" aria-hidden="true" />
                <span
                  class="truncate"
                  data-i18n-bn={currentCategoryMeta.id === 'pdf' ? 'সব PDF টুলস' : currentCategoryMeta.id === 'image' ? 'সব ইমেজ টুলস' : `সব ${currentCategoryMeta.title}`}
                  data-i18n-en={currentCategoryMeta.id === 'pdf' ? 'All PDF Tools' : currentCategoryMeta.id === 'image' ? 'All Image Tools' : `All ${currentCategoryMeta.titleEn}`}
                >
                  {currentCategoryMeta.id === 'pdf' ? 'সব PDF টুলস' : currentCategoryMeta.id === 'image' ? 'সব ইমেজ টুলস' : `সব ${currentCategoryMeta.title}`}
                </span>
              </a>
