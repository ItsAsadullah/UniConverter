---
import { TOOLS, getToolMeta, type ToolMeta } from '../data/tools';

interface Props {
  toolId: ToolMeta['id'];
  title?: string;
  description?: string;
  activeBadgeText?: string;
}

const { toolId, title, description, activeBadgeText } = Astro.props;
const currentTool = getToolMeta(toolId);
const pageTitle = title || currentTool.seoTitle;
const pageDesc = description || currentTool.seoDesc;
const otherTools = TOOLS.filter((t) => t.id !== toolId);
const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
const toBn = (n: number | string) => String(n).replace(/\d/g, (d) => bnDigits[Number(d)]);
const otherCountBn = `${toBn(otherTools.length)}টি`;
const currentYearBn = toBn(new Date().getFullYear());
---
<!doctype html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('thbc-theme') || localStorage.getItem('color-scheme');
        var theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        var meta = document.querySelector('meta[name="color-scheme"]');
        if (meta) meta.content = theme;
        if (localStorage.getItem('thbc-cache-ver') !== 'v18') {
          localStorage.setItem('thbc-cache-ver', 'v18');
          var hadStale = false;
          var p = [];
          if (window.caches) {
            p.push(caches.keys().then(function (ks) {
              if (ks.length) hadStale = true;
              return Promise.all(ks.map(function (k) { return caches.delete(k); }));
            }));
          }
          if ('serviceWorker' in navigator) {
            p.push(navigator.serviceWorker.getRegistrations().then(function (rs) {
              if (rs.length) hadStale = true;
              return Promise.all(rs.map(function (r) { return r.unregister(); }));
            }));
          }
          if (p.length) {
            Promise.all(p).then(function () { if (hadStale) location.reload(); });
          }
        }
      } catch (e) {}
    })();
  </script>
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <meta name="theme-color" content="#0a0f1d">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" sizes="48x48" href="/icons/icon-48.png">
  <link rel="apple-touch-icon" href="/icons/icon-180.png">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anek+Bangla:wght@400;500;600;700&family=Tiro+Bangla&display=swap">
  <link rel="stylesheet" href="/css/app.css?v=18">
</head>
<body data-astro-mpa="1" data-active-tool={toolId}>
  <a class="skip-link" href="#workbench">মূল অংশে যান</a>

  <header class="topbar">
    <div class="topbar__inner">
      <a class="brand" href="/" aria-label="TechHat বাংলা কনভার্টার ও ইউটিলিটি হাব — হোম">
        <img class="brand__mark" src="/icons/icon-192.png" width="34" height="34" alt="">
        <h1 class="brand__name">TechHat <b>ইউটিলিটি হাব</b></h1>
      </a>

      {toolId === 'bijoy' ? (
        <div class="tabs" id="bijoyTabs" role="tablist" aria-label="কনভার্টারের ধরন">
          <button class="tab" role="tab" id="tab-text" aria-controls="panel-text" aria-selected="true" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h14"/></svg> টেক্সট
          </button>
          <button class="tab" role="tab" id="tab-file" aria-controls="panel-file" aria-selected="false" tabindex="-1" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg> ফাইল
          </button>
          <span class="tabs__ink" aria-hidden="true"></span>
        </div>
      ) : (
        <div class="active-tool-header" id="activeToolHeader">
          <span class="active-tool-pill" id="activeToolName" set:html={`${currentTool.icon} <span>${activeBadgeText || currentTool.title}</span>`} />
          {toolId === 'calendar' && (
            <button class="chip-btn" id="btnCalReset" type="button" title="আজকের তারিখে ফিরে যান">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3M18 3v4h-4M6 21v-4h4"/></svg>
              আজকের তারিখ
            </button>
          )}
        </div>
      )}

      <div class="topbar__actions">
        <button class="icon-btn theme-toggle" id="themeToggle" type="button" aria-label="থিম পরিবর্তন করুন (লাইট / ডার্ক)" title="লাইট ও ডার্ক থিম পরিবর্তন">
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <span class="icon-btn__label theme-toggle__label">থিম</span>
        </button>
        <button class="icon-btn" id="installBtn" type="button" hidden title="অ্যাপ হিসেবে ইনস্টল করুন">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14"/></svg>
          <span class="icon-btn__label">ইনস্টল</span>
        </button>
      </div>
    </div>
  </header>

  <main id="workbench" class="workbench">
    <div class="workbench-grid">
      <div class="tool-stage">
        <slot />
      </div>

      <aside class="tools-sidebar" id="toolsSidebar" aria-label="অন্যান্য টুলস">
        <div class="tools-sidebar__card">
          <div class="tools-sidebar__head">
            <div class="tools-sidebar__title">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
              <span>অন্যান্য টুলস</span>
            </div>
            <span class="tools-sidebar__count" id="toolsCountBadge">{otherCountBn}</span>
          </div>
          <div class="tools-sidebar__search">
            <input type="search" id="toolSearch" placeholder="টুল খুঁজুন…" autocomplete="off" aria-label="টুল খুঁজুন">
          </div>
          <div class="tools-sidebar__list" id="toolsSidebarList" role="navigation" aria-label="টুল তালিকা">
            {otherTools.map((t) => (
              <a
                href={t.href}
                class="tool-nav-card"
                data-color={t.color}
                data-tool-id={t.id}
                data-keywords={t.keywords}
                data-badge={t.badge}
              >
                <span class="tool-nav-card__icon" set:html={t.icon} />
                <span class="tool-nav-card__body">
                  <span class="tool-nav-card__title">{t.title}</span>
                  <span class="tool-nav-card__desc">{t.desc}</span>
                </span>
                <span class="tool-nav-card__arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </main>

  <slot name="after-workbench" />

  <footer class="footer">
    <p>© <span id="year">{currentYearBn}</span> TechHat • সব রূপান্তর ও হিসাব আপনার ডিভাইসেই হয়, কোনো ডেটা কোথাও পাঠানো হয় না।</p>
  </footer>

  <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

  <script is:inline src="/js/shell.js?v=16" defer></script>
  <slot name="scripts" />
</body>
</html>
