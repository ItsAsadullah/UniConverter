---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ImageStudio from '../../components/ImageStudio.svelte';
import { IMAGE_SUBTOOLS, type ImageSubToolMeta } from '../../data/tools';

export function getStaticPaths() {
  const basePaths = IMAGE_SUBTOOLS.map((sub) => ({
    params: { tool: sub.slug },
    props: { sub }
  }));
  const scanSub = IMAGE_SUBTOOLS.find((s) => s.slug === 'scan')!;
  return [
    ...basePaths,
    {
      params: { tool: 'scanner' },
      props: { sub: scanSub }
    }
  ];
}

interface Props {
  sub: ImageSubToolMeta;
}

const { sub } = Astro.props;
---
<ToolLayout
  toolId="image"
  activeCategory="image"
  title={sub.seoTitle}
  description={sub.seoDesc}
  activeBadgeText={`ইমেজ স্টুডিও • ${sub.title}`}
>
  <ImageStudio initialTab={sub.tabId} />

  <Fragment slot="scripts">
    <script is:inline src="/vendor/jszip.min.js" defer></script>
    <script is:inline src="/js/image-tools.js?v=61" defer></script>
    {sub.tabId === 'scan' && (
      <>
        <script is:inline src="/js/document-scan-core.js?v=23" defer></script>
        <script is:inline src="/js/document-scanner.js?v=40" defer></script>
      </>
    )}
  </Fragment>
</ToolLayout>
