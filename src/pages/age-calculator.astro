---
import ToolLayout from '../layouts/ToolLayout.astro';
import DateModals from '../components/DateModals.astro';
---
<ToolLayout toolId="age">
  <div class="tool-view" id="tool-age">
    <section class="card util-card" aria-label="বয়স ম্যানেজার">
      <div class="sub-tabs" role="tablist">
        <button type="button" class="sub-tab-btn active" onclick="window.TechHatTools.switchAgeTab('calc')" id="at-calc">বয়স বের করুন</button>
        <button type="button" class="sub-tab-btn" onclick="window.TechHatTools.switchAgeTab('find')" id="at-find">জন্মতারিখ বের করুন</button>
      </div>

      <div class="util-body" id="av-calc">
        <div class="dual-panel">
          <div class="picker-stack">
            <div class="picker-area">
              <div class="section-header">জন্ম তারিখ</div>
              <div class="picker-heads"><span>দিন</span><span>মাস</span><span>সাল</span></div>
              <div class="p-row">
                <div class="swipe-box" id="adD"><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('dob','d',1)">▲</button><div class="mid-area" data-grid="d" data-ref="adD-txt"><div class="val-disp" id="adD-txt">০১</div></div><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('dob','d',-1)">▼</button></div>
                <div class="swipe-box" id="adM"><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('dob','m',1)">▲</button><div class="mid-area" data-grid="m" data-ref="adM-txt"><div class="val-disp small" id="adM-txt">Jan</div></div><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('dob','m',-1)">▼</button></div>
                <div class="swipe-box" id="adY"><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('dob','y',1)">▲</button><div class="mid-area" onclick="window.TechHatTools.edAgeY('dob')"><div class="val-disp" id="adY-txt">২০০০</div><input type="number" class="num-inp" id="adY-inp" onblur="window.TechHatTools.clAgeY('dob')"></div><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('dob','y',-1)">▼</button></div>
              </div>
            </div>
            <div class="picker-area">
              <div class="section-header">হিসাবের / আজকের তারিখ</div>
              <div class="picker-heads"><span>দিন</span><span>মাস</span><span>সাল</span></div>
              <div class="p-row">
                <div class="swipe-box" id="arD"><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('ref','d',1)">▲</button><div class="mid-area" data-grid="d" data-ref="arD-txt"><div class="val-disp" id="arD-txt">০১</div></div><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('ref','d',-1)">▼</button></div>
                <div class="swipe-box" id="arM"><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('ref','m',1)">▲</button><div class="mid-area" data-grid="m" data-ref="arM-txt"><div class="val-disp small" id="arM-txt">Jan</div></div><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('ref','m',-1)">▼</button></div>
                <div class="swipe-box" id="arY"><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('ref','y',1)">▲</button><div class="mid-area" onclick="window.TechHatTools.edAgeY('ref')"><div class="val-disp" id="arY-txt">২০২৬</div><input type="number" class="num-inp" id="arY-inp" onblur="window.TechHatTools.clAgeY('ref')"></div><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('ref','y',-1)">▼</button></div>
              </div>
            </div>
          </div>

          <div class="age-highlight-wrap">
            <div class="age-highlight-head">আপনার বর্তমান বয়স</div>
            <div class="age-highlight-body">
              <div class="age-main-val" id="age-main">...</div>
              <button type="button" class="ai-btn" onclick="window.TechHatTools.showAILifeInsights()">✦ আমার সম্পর্কে বিস্তারিত</button>
            </div>
          </div>
        </div>

        <div class="stats-grid">
          <div class="stat-item"><div class="stat-val" id="st-month">০</div><div class="stat-lbl">মোট মাস</div></div>
          <div class="stat-item"><div class="stat-val" id="st-week">০</div><div class="stat-lbl">মোট সপ্তাহ</div></div>
          <div class="stat-item"><div class="stat-val" id="st-day">০</div><div class="stat-lbl">মোট দিন</div></div>
          <div class="stat-item"><div class="stat-val" id="st-hour">০</div><div class="stat-lbl">মোট ঘণ্টা</div></div>
          <div class="stat-item"><div class="stat-val" id="st-min">০</div><div class="stat-lbl">মোট মিনিট</div></div>
          <div class="stat-item"><div class="stat-val" id="st-sec">০</div><div class="stat-lbl">মোট সেকেন্ড</div></div>
        </div>
      </div>

      <div class="util-body" id="av-find" hidden>
        <div class="dual-panel">
          <div class="picker-stack">
            <div class="picker-area">
              <div class="section-header">হিসাবের তারিখ</div>
              <div class="picker-heads"><span>দিন</span><span>মাস</span><span>সাল</span></div>
              <div class="p-row">
                <div class="swipe-box" id="afD"><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('fref','d',1)">▲</button><div class="mid-area" data-grid="d" data-ref="afD-txt"><div class="val-disp" id="afD-txt">০১</div></div><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('fref','d',-1)">▼</button></div>
                <div class="swipe-box" id="afM"><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('fref','m',1)">▲</button><div class="mid-area" data-grid="m" data-ref="afM-txt"><div class="val-disp small" id="afM-txt">Jan</div></div><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('fref','m',-1)">▼</button></div>
                <div class="swipe-box" id="afY"><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('fref','y',1)">▲</button><div class="mid-area" onclick="window.TechHatTools.edAgeY('fref')"><div class="val-disp" id="afY-txt">২০২৬</div><input type="number" class="num-inp" id="afY-inp" onblur="window.TechHatTools.clAgeY('fref')"></div><button type="button" class="arr-btn" onclick="window.TechHatTools.updAge('fref','y',-1)">▼</button></div>
              </div>
            </div>
            <div class="picker-area">
              <div class="section-header">বয়স কত?</div>
              <div class="picker-heads"><span>বছর</span><span>মাস</span><span>দিন</span></div>
              <div class="p-row">
                <div class="swipe-box" id="agY"><button type="button" class="arr-btn" onclick="window.TechHatTools.updRev('y',1)">▲</button><div class="mid-area" onclick="window.TechHatTools.edRev('y')"><div class="val-disp" id="agY-txt">০</div><input type="number" class="num-inp" id="agY-inp" onblur="window.TechHatTools.clRev('y')"></div><button type="button" class="arr-btn" onclick="window.TechHatTools.updRev('y',-1)">▼</button></div>
                <div class="swipe-box" id="agM"><button type="button" class="arr-btn" onclick="window.TechHatTools.updRev('m',1)">▲</button><div class="mid-area" onclick="window.TechHatTools.edRev('m')"><div class="val-disp" id="agM-txt">০</div><input type="number" class="num-inp" id="agM-inp" onblur="window.TechHatTools.clRev('m')"></div><button type="button" class="arr-btn" onclick="window.TechHatTools.updRev('m',-1)">▼</button></div>
                <div class="swipe-box" id="agD"><button type="button" class="arr-btn" onclick="window.TechHatTools.updRev('d',1)">▲</button><div class="mid-area" onclick="window.TechHatTools.edRev('d')"><div class="val-disp" id="agD-txt">০</div><input type="number" class="num-inp" id="agD-inp" onblur="window.TechHatTools.clRev('d')"></div><button type="button" class="arr-btn" onclick="window.TechHatTools.updRev('d',-1)">▼</button></div>
              </div>
            </div>
          </div>

          <div class="age-highlight-wrap">
            <div class="age-highlight-head">সম্ভাব্য জন্ম তারিখ</div>
            <div class="age-highlight-body">
              <div class="dob-main-row">
                <div class="dob-main-val" id="dob-main">...</div>
                <span class="meta-pill" id="dob-season">...</span>
              </div>
              <div class="dob-sub-bn" id="dob-bn">...</div>
              <div class="dob-sub-hj" id="dob-hj">...</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <DateModals slot="after-workbench" />

  <Fragment slot="scripts">
    <script is:inline src="/js/tools.js" defer></script>
  </Fragment>
</ToolLayout>
