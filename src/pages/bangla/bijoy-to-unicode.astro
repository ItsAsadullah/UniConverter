---
import ToolLayout from '../../layouts/ToolLayout.astro';
import BijoyWorkspace from '../../components/BijoyWorkspace.svelte';
---

<ToolLayout
  toolId="bijoy"
  activeCategory="bangla"
  title="Bijoy ⇄ Unicode Converter — বিজয় ও ইউনিকোড কনভার্টার | TechHat Studio"
  description="Instant Bijoy (SutonnyMJ) to Unicode and Unicode to Bijoy converter with MS Word rich copy."
>
  <BijoyWorkspace
    initialTab="text"
    workspaceTitle="বিজয় ⇄ ইউনিকোড কনভার্টার"
    workspaceTitleEn="Bijoy ⇄ Unicode Converter"
  />

  <Fragment slot="scripts">
    <script is:inline src="/vendor/jszip.min.js" defer></script>
    <script is:inline src="/js/bijoy-engine.js?v=70" defer></script>
    <script is:inline src="/js/office.js?v=70" defer></script>
    <script is:inline src="/js/formats.js?v=70" defer></script>
    <script is:inline src="/js/app.js?v=70" defer></script>
  </Fragment>
</ToolLayout>
